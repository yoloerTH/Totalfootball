---
import Mark from './brand/Mark.astro'
import { THEMES } from '../lib/theme'

const nav = [
  { href: '/library/', label: 'Library' },
  { href: '/studio/', label: 'Studio' },
  { href: '/intelligence/', label: 'Intelligence' },
  { href: '/course/', label: 'Course' },
  { href: '/about/', label: 'About' },
]

// Mark the current section so the nav reflects where you are, including on
// nested routes like /library/back-four/.
const here = Astro.url.pathname
const isCurrent = (href: string) => here === href || (href !== '/' && here.startsWith(href))
---

<header class="sticky top-0 z-40 border-b border-ink-hair bg-paper/85 backdrop-blur-md">
  <div class="shell flex h-16 items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-2.5" aria-label="Total Football home">
      <Mark size={30} disc={false} />
      <span class="text-[13px] font-bold uppercase tracking-[0.16em] text-ink"> Total Football </span>
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-1 md:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
            class:list={[
              'rounded-full px-4 py-2 text-sm font-medium transition-colors',
              isCurrent(item.href) ? 'text-ink' : 'text-ink-soft hover:text-ink',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      {/*
        The theme picker. Four grounds now rather than two, which is one more
        than a toggle can carry: a button that cycles day → night → broadcast →
        floodlit makes a reader press it three times to get back to where they
        were and never says what the next press will do. So it is a menu, and
        every option is visible with its own swatch before anything changes.

        Light is still the default and still the absence of an attribute.
      */}
      <div class="relative">
        <button
          type="button"
          id="tf-theme"
          class="flex h-9 items-center gap-2 rounded-full border border-ink-hair pl-1.5 pr-3 text-ink-soft transition-colors hover:border-ink/25 hover:text-ink"
          aria-haspopup="menu"
          aria-expanded="false"
          aria-label="Theme"
        >
          <span
            id="tf-theme-swatch"
            class="h-6 w-6 shrink-0 rounded-full border border-ink-hair"
            style="background:#F4F4F2"
            aria-hidden="true"></span>
          <span id="tf-theme-name" class="text-[13px] font-medium">Day</span>
        </button>

        <div
          id="tf-theme-menu"
          role="menu"
          aria-label="Theme"
          hidden
          class="absolute right-0 z-50 mt-2 w-64 overflow-hidden rounded-2xl border border-ink-hair bg-surface p-1.5 shadow-lift"
        >
          {
            THEMES.map((t) => (
              <button
                type="button"
                role="menuitemradio"
                aria-checked="false"
                data-theme-id={t.id}
                class="flex w-full items-start gap-2.5 rounded-xl px-2 py-2 text-left transition-colors hover:bg-paper"
              >
                <span
                  class="mt-0.5 h-6 w-6 shrink-0 rounded-full border border-ink-hair"
                  style={`background:linear-gradient(135deg, ${t.paper} 55%, ${t.accent} 55%)`}
                  aria-hidden="true"
                />
                <span class="min-w-0">
                  <span class="block text-[13px] font-semibold text-ink">{t.label}</span>
                  <span class="block text-[11px] leading-snug text-ink-faint">{t.hint}</span>
                </span>
                <svg
                  class="tf-tick ml-auto mt-1 hidden h-4 w-4 shrink-0 text-ink"
                  viewBox="0 0 20 20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M4 10.5 8 14.5 16 6" />
                </svg>
              </button>
            ))
          }
        </div>
      </div>

      <a href="/library/" class="btn-primary !px-5 !py-2 text-[13px]" data-track="nav:library"
        >Browse systems</a
      >
    </div>
  </div>

  {/* Mobile nav: a plain scrollable row. No drawer, no JS, no layout shift. */}
  <nav
    aria-label="Primary mobile"
    class="flex gap-1 overflow-x-auto border-t border-ink-hair px-4 py-2 md:hidden"
  >
    {
      nav.map((item) => (
        <a
          href={item.href}
          aria-current={isCurrent(item.href) ? 'page' : undefined}
          class:list={[
            'whitespace-nowrap rounded-full px-3.5 py-1.5 text-[13px] font-medium',
            isCurrent(item.href) ? 'bg-ink text-paper' : 'text-ink-soft',
          ]}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>

<script is:inline define:vars={{ THEME_LIST: THEMES }}>
  ;(function () {
    var btn = document.getElementById('tf-theme')
    var menu = document.getElementById('tf-theme-menu')
    if (!btn || !menu) return

    var root = document.documentElement
    var swatch = document.getElementById('tf-theme-swatch')
    var name = document.getElementById('tf-theme-name')
    var meta = document.querySelector('meta[name="theme-color"]')
    var items = menu.querySelectorAll('[data-theme-id]')

    function current() {
      var id = root.getAttribute('data-theme') || 'light'
      for (var i = 0; i < THEME_LIST.length; i++) {
        if (THEME_LIST[i].id === id) return THEME_LIST[i]
      }
      return THEME_LIST[0]
    }

    function render() {
      var t = current()
      swatch.style.background = 'linear-gradient(135deg, ' + t.paper + ' 55%, ' + t.accent + ' 55%)'
      name.textContent = t.label
      if (meta) meta.setAttribute('content', t.paper)
      items.forEach(function (el) {
        var on = el.getAttribute('data-theme-id') === t.id
        el.setAttribute('aria-checked', on ? 'true' : 'false')
        el.querySelector('.tf-tick').classList.toggle('hidden', !on)
      })
    }

    function open(state) {
      menu.hidden = !state
      btn.setAttribute('aria-expanded', state ? 'true' : 'false')
    }

    // Light is the ABSENCE of the attribute, not a value of it, so that a
    // first-time visitor and a visitor who has chosen day are the same page.
    function apply(id, remember) {
      if (id === 'light') root.removeAttribute('data-theme')
      else root.setAttribute('data-theme', id)
      if (remember) {
        try {
          localStorage.setItem('tf_theme', id)
        } catch (e) {
          // Private mode. The theme still applies for this session.
        }
      }
      render()
    }

    render()

    btn.addEventListener('click', function (e) {
      e.stopPropagation()
      open(menu.hidden)
    })

    items.forEach(function (el) {
      el.addEventListener('click', function () {
        apply(el.getAttribute('data-theme-id'), true)
        open(false)
        btn.focus()
      })
    })

    document.addEventListener('click', function (e) {
      if (!menu.hidden && !menu.contains(e.target)) open(false)
    })
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !menu.hidden) {
        open(false)
        btn.focus()
      }
    })

    // A second tab — or the studio, which writes the same key — changing the
    // theme changes it here too. Not remembered again: it is already stored,
    // and writing back would bounce the event between two open tabs.
    window.addEventListener('storage', function (e) {
      if (e.key === 'tf_theme' && e.newValue) apply(e.newValue, false)
    })
  })()
</script>
