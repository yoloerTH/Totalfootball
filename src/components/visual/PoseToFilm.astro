---
/**
 * The one idea the studio rests on, drawn.
 *
 * "A phase is a moment, not a keyframe" is the hardest sentence on the studio's
 * landing page and the most important. Three panels say it without the
 * sentence: the same six players posed twice, and a third panel where the
 * movement between them plays. Nobody keyframed the third panel — that is the
 * whole point, and it is why the third panel is the only one that moves.
 *
 * WHAT THE THIRD PANEL SHOWS, and why it is not just the same board again:
 * the first pose stays in it as a ghost, every player is joined to where they
 * end up by an arrow, and a scrub bar runs underneath in lock step. Those three
 * things are the studio's actual output — the in-between — and drawing them is
 * the difference between illustrating the sentence and proving it.
 *
 * Same technique as MiniBoard, StudioDeck and AgentFlow: pure SVG, CSS
 * keyframes, no JS, frozen to a readable still under reduced-motion. One
 * 8-second timeline.
 *
 * THE MOVEMENT IS NOT HAND-WRITTEN IN THE CSS. Each counter carries its own
 * `--dx/--dy` from the pose data below and one shared keyframe uses them, so
 * moving a player in `A` or `B` moves them on the page. The previous version
 * had six hand-numbered keyframe blocks that had to be kept in step with the
 * coordinates by eye, which is exactly the kind of thing that silently rots.
 *
 * The counters are drawn here rather than reused from src/studio/board — that
 * is a React component and this is a static Astro page with no island. A
 * simplified counter is the right call anyway at this size: the real one has a
 * dome gradient and a shadow that turn to mud at 22px.
 */
interface Props {
  class?: string
  title?: string
}

const { class: klass = '', title } = Astro.props

const GREEN = '#08C16A'
const GREEN_DEEP = '#06A659'
const GOLD = '#E6B23A'

const PANEL_W = 208
const PANEL_H = 146

/** Six players, posed twice. Index-matched: player i moves from A[i] to B[i]. */
const A = [
  { x: 34, y: 44, l: 'CB' },
  { x: 34, y: 102, l: 'CB' },
  { x: 72, y: 24, l: 'LB' },
  { x: 72, y: 122, l: 'RB' },
  { x: 100, y: 54, l: 'DM' },
  { x: 100, y: 92, l: 'CM' },
]
const B = [
  { x: 58, y: 42, l: 'CB' },
  { x: 58, y: 104, l: 'CB' },
  { x: 112, y: 20, l: 'LB' },
  { x: 112, y: 126, l: 'RB' },
  { x: 138, y: 62, l: 'DM' },
  { x: 156, y: 96, l: 'CM' },
]

/** Where the ball sits in each pose. It is carried, so it moves too. */
const BALL_A = { x: 66, y: 74 }
const BALL_B = { x: 128, y: 78 }

/**
 * The in-between, computed once. `deg` points the arrow head down the line of
 * travel; `len` is what decides whether a player has moved far enough to be
 * worth drawing an arrow for at all — six arrows of four pixels is noise.
 */
const MOVES = A.map((a, i) => {
  const b = B[i]
  const dx = b.x - a.x
  const dy = b.y - a.y
  const len = Math.hypot(dx, dy)
  return { i, a, b, dx, dy, len, deg: (Math.atan2(dy, dx) * 180) / Math.PI }
})

/** Stop the arrow short of the counter it points at, or it lands underneath. */
const HEAD_GAP = 15

const PANELS = [
  { key: 'a', label: 'Phase 1', sub: 'You pose it' },
  { key: 'b', label: 'Phase 2', sub: 'You pose it again' },
  { key: 'play', label: 'Play', sub: 'Worked out for you' },
] as const
---

<figure class={`m-0 ${klass}`}>
  <div class="grid items-center gap-4 sm:grid-cols-[1fr_auto_1fr_auto_1fr] sm:gap-3">
    {
      PANELS.map((panel, p) => {
        const play = panel.key === 'play'
        const pose = panel.key === 'b' ? B : A
        const ball = panel.key === 'b' ? BALL_B : BALL_A
        return (
          <>
            {p > 0 && (
              /* The operators. A hairline through a circled glyph, so the three
                 panels read as one sentence rather than three pictures. */
              <div class="flex items-center justify-center py-1 sm:py-0" aria-hidden="true">
                <span class="hidden h-px w-2 bg-ink-hair sm:block" />
                <span class="grid h-7 w-7 place-items-center rounded-full border border-ink-hair bg-paper text-[13px] font-black text-ink-faint">
                  {p === 1 ? '+' : '='}
                </span>
                <span class="hidden h-px w-2 bg-ink-hair sm:block" />
              </div>
            )}

            <div class="relative">
              <svg
                viewBox={`0 0 ${PANEL_W} ${PANEL_H}`}
                class:list={[
                  'block w-full rounded-xl border bg-paper text-ink',
                  play ? 'border-gold/45 shadow-paper' : 'border-ink-hair',
                ]}
                role={title && play ? 'img' : 'presentation'}
                aria-label={title && play ? title : undefined}
                aria-hidden={title && play ? undefined : 'true'}
              >
                {/* ── pitch furniture ── */}
                <g fill="none" stroke="currentColor" stroke-width="1">
                  <path d={`M 0 26 H 46 V ${PANEL_H - 26} H 0`} stroke-opacity="0.13" />
                  <path d={`M 0 52 H 20 V ${PANEL_H - 52} H 0`} stroke-opacity="0.1" />
                  <path d={`M 46 60 A 26 26 0 0 1 46 ${PANEL_H - 60}`} stroke-opacity="0.1" />
                  <path
                    d={`M ${PANEL_W - 30} 0 V ${PANEL_H}`}
                    stroke-opacity="0.12"
                    stroke-dasharray="3 5"
                  />
                </g>

                {play && (
                  <>
                    {/* Where they were. The pose does not disappear when the
                        movement starts — it is the thing being moved from. */}
                    <g fill="none" stroke={GREEN} stroke-opacity="0.34" stroke-dasharray="3 3">
                      {A.map((a) => (
                        <circle cx={a.x} cy={a.y} r="11" />
                      ))}
                    </g>

                    {/* And where they are going. */}
                    <g stroke={GREEN_DEEP} stroke-opacity="0.55" stroke-width="1.4" fill="none">
                      {MOVES.filter((m) => m.len > 18).map((m) => {
                        const ux = m.dx / m.len
                        const uy = m.dy / m.len
                        const hx = m.b.x - ux * HEAD_GAP
                        const hy = m.b.y - uy * HEAD_GAP
                        return (
                          <>
                            <path
                              d={`M ${m.a.x + ux * 13} ${m.a.y + uy * 13} L ${hx} ${hy}`}
                              stroke-linecap="round"
                            />
                            <path
                              d="M -5 -3.4 L 0 0 L -5 3.4"
                              transform={`translate(${hx} ${hy}) rotate(${m.deg})`}
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            />
                          </>
                        )
                      })}
                    </g>
                  </>
                )}

                {/* ── the counters ── */}
                {pose.map((t, k) => (
                  <g
                    class={play ? 'ptf-t' : undefined}
                    style={play ? `--dx:${MOVES[k].dx}px; --dy:${MOVES[k].dy}px` : undefined}
                  >
                    <circle cx={t.x} cy={t.y} r="11" fill={GREEN} />
                    <text
                      x={t.x}
                      y={t.y + 3.5}
                      text-anchor="middle"
                      font-size="9"
                      font-weight="900"
                      fill="#fff"
                      font-family="Inter Variable, Inter, sans-serif"
                    >
                      {t.l}
                    </text>
                  </g>
                ))}

                {/* The ball is carried, so it travels with the phase. In the two
                    posed panels it simply sits where the coach left it. */}
                <circle
                  class={play ? 'ptf-ball' : undefined}
                  style={play ? `--dx:${BALL_B.x - BALL_A.x}px; --dy:${BALL_B.y - BALL_A.y}px` : undefined}
                  cx={ball.x}
                  cy={ball.y}
                  r="5"
                  fill={GOLD}
                  stroke="#fff"
                  stroke-width="1.2"
                />

                {play && (
                  /* The scrub bar. It is not decoration: it is the only thing
                     on the page that says the output has a duration. */
                  <g>
                    <rect
                      x="12"
                      y={PANEL_H - 12}
                      width={PANEL_W - 24}
                      height="3"
                      rx="1.5"
                      fill="currentColor"
                      fill-opacity="0.12"
                    />
                    <rect
                      class="ptf-scrub"
                      x="12"
                      y={PANEL_H - 12}
                      width={PANEL_W - 24}
                      height="3"
                      rx="1.5"
                      fill={GOLD}
                    />
                  </g>
                )}
              </svg>

              {/* The badge sits over the panel rather than under it, so the
                  three captions below stay one clean row. */}
              <span
                class:list={[
                  'absolute left-2.5 top-2.5 rounded-md px-1.5 py-0.5 text-[10px] font-black tabular-nums',
                  play ? 'bg-gold/15 text-ink' : 'bg-ink/[0.06] text-ink-faint',
                ]}
                aria-hidden="true"
              >
                {play ? '▶' : p + 1}
              </span>

              <p class="mt-3 text-center text-[11px] font-bold uppercase tracking-micro text-ink-faint">
                {panel.label}
              </p>
              <p class="mt-1 text-center text-[12px] text-ink-soft">{panel.sub}</p>
            </div>
          </>
        )
      })
    }
  </div>

  <figcaption class="mx-auto mt-8 max-w-xl text-center text-[13px] leading-relaxed text-ink-soft">
    No timeline. No keyframes. No easing curves to pick. You put the players where the ball takes
    them, and everything between the two moments is the studio's problem.
  </figcaption>
</figure>

<style>
  /*
   * ONE 8-SECOND TIMELINE, and every counter shares it:
   *
   *   0 – 18%   hold on phase 1
   *   18 – 46%  the movement
   *   46 – 74%  hold on phase 2 — long enough to read the new shape
   *   74 – 94%  rewind
   *   94 – 100% settled back on phase 1
   *
   * The house curve, fast out and long settle, the same one the board's own
   * tweening uses. The hold windows are the reason an eye has time to read a
   * shape before it changes; they are the pacing rule the shorts are built on.
   *
   * Each element carries its own --dx/--dy from the pose data, so there is
   * exactly one keyframe block here no matter how many players are on the
   * board.
   */
  .ptf-t,
  .ptf-ball,
  .ptf-scrub {
    animation-duration: 8s;
    animation-iteration-count: infinite;
    animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ptf-t,
  .ptf-ball {
    animation-name: ptf-move;
  }
  .ptf-scrub {
    animation-name: ptf-scrub;
    /* Stated rather than left to the default, so the bar grows from its left
       edge in every engine instead of from the middle of the viewBox. */
    transform-box: view-box;
    transform-origin: 12px 0;
  }

  @keyframes ptf-move {
    0%,
    18% {
      transform: translate(0, 0);
    }
    46%,
    74% {
      transform: translate(var(--dx), var(--dy));
    }
    94%,
    100% {
      transform: translate(0, 0);
    }
  }

  /* The bar fills as the phase plays and empties as it rewinds, so the panel
     and the scrub can never disagree about where in the phase we are. */
  @keyframes ptf-scrub {
    0%,
    18% {
      transform: scaleX(0);
    }
    46%,
    74% {
      transform: scaleX(1);
    }
    94%,
    100% {
      transform: scaleX(0);
    }
  }

  /* Reduced motion: hold the played panel on the second pose, with the ghost
     and the arrows still showing where it came from. That is the whole idea in
     a still, which is the bar every visual on this site is held to. */
  @media (prefers-reduced-motion: reduce) {
    .ptf-t,
    .ptf-ball,
    .ptf-scrub {
      animation: none;
    }
    .ptf-t,
    .ptf-ball {
      transform: translate(var(--dx), var(--dy));
    }
    .ptf-scrub {
      transform: scaleX(1);
    }
  }
</style>
