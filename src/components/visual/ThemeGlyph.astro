---
/**
 * A small diagram per library theme. Each one states the theme's actual idea
 * rather than being an icon: a back four for defending, three lanes out of a
 * press for build-up, a cover shadow for pressing, a triangle in the final
 * third for attacking, a curved delivery for set pieces.
 *
 * Used on theme cards and hub headers to give the library grid something to
 * look at besides type.
 */
import type { ThemeSlug } from '../../data/systems'

interface Props {
  theme: ThemeSlug
  class?: string
}

const { theme, class: klass = '' } = Astro.props

const GREEN = '#08C16A'
const RED = '#E2473B'
const GOLD = '#E6B23A'
const INK = 'rgba(22,22,24,0.22)'
---

<svg viewBox="0 0 120 84" class={klass} aria-hidden="true" focusable="false">
  <rect x="1" y="1" width="118" height="82" rx="4" fill="none" stroke={INK} stroke-width="1.2" />

  {
    theme === 'defending' && (
      <g class="tg-a">
        {/* a connected back four, staggered */}
        <path
          d="M86,18 L92,34 L92,50 L86,66"
          fill="none"
          stroke={GREEN}
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        {[18, 34, 50, 66].map((y, i) => (
          <circle cx={i === 1 || i === 2 ? 92 : 86} cy={y} r="6" fill={GREEN} />
        ))}
        <circle cx="34" cy="42" r="6" fill={RED} />
        <path
          d="M42,42 L76,42"
          stroke={GOLD}
          stroke-width="1.8"
          stroke-dasharray="4 4"
          class="tg-dash"
        />
      </g>
    )
  }

  {
    theme === 'build-up' && (
      <g>
        {/* one player, three ways out */}
        <circle cx="26" cy="42" r="6" fill={GREEN} />
        {[
          'M34,42 C56,42 66,20 92,20',
          'M34,42 L92,42',
          'M34,42 C56,42 66,64 92,64',
        ].map((d, i) => (
          <path
            d={d}
            fill="none"
            stroke={i === 1 ? GOLD : GREEN}
            stroke-width="2"
            stroke-linecap="round"
            class={`tg-draw tg-draw-${i}`}
          />
        ))}
        {[20, 42, 64].map((y) => (
          <circle cx="96" cy={y} r="5" fill={GREEN} opacity="0.85" />
        ))}
      </g>
    )
  }

  {
    theme === 'pressing' && (
      <g>
        {/* the cover shadow: one presser screening the pass behind him */}
        <path d="M42,42 L108,14 L108,70 Z" fill={GOLD} fill-opacity="0.16" />
        <circle cx="34" cy="42" r="6.5" fill={GREEN} />
        <circle cx="34" cy="42" r="12" fill="none" stroke={GOLD} stroke-width="2" class="tg-pulse" />
        <circle cx="72" cy="42" r="6" fill={RED} />
        <circle cx="100" cy="24" r="5" fill={RED} opacity="0.35" />
      </g>
    )
  }

  {
    theme === 'attacking' && (
      <g>
        {/* a triangle in the final third, one runner arriving */}
        <path
          d="M30,60 L64,22 L98,54 Z"
          fill="none"
          stroke={GREEN}
          stroke-width="2"
          stroke-linejoin="round"
          class="tg-draw tg-draw-0"
        />
        <circle cx="30" cy="60" r="6" fill={GREEN} />
        <circle cx="64" cy="22" r="6" fill={GREEN} />
        <circle cx="98" cy="54" r="6" fill={GREEN} />
        <circle cx="64" cy="60" r="5" fill={GOLD} class="tg-a" />
      </g>
    )
  }

  {
    theme === 'set-pieces' && (
      <g>
        {/* a curved delivery into the six-yard box */}
        <rect x="74" y="18" width="34" height="48" fill="none" stroke={INK} stroke-width="1.2" />
        <path
          d="M22,64 C48,64 66,22 96,30"
          fill="none"
          stroke={GOLD}
          stroke-width="2"
          stroke-linecap="round"
          class="tg-draw tg-draw-0"
        />
        <circle cx="20" cy="64" r="4.5" fill="#fff" stroke="#161618" stroke-width="1.4" />
        {[30, 46].map((y, i) => (
          <circle cx={88 + i * 8} cy={y} r="5.5" fill={i === 0 ? GREEN : RED} />
        ))}
      </g>
    )
  }
</svg>

<style>
  .tg-dash {
    stroke-dasharray: 4 4;
    animation: tg-march 1.6s linear infinite;
  }
  @keyframes tg-march {
    to {
      stroke-dashoffset: -8;
    }
  }

  .tg-draw {
    stroke-dasharray: 160;
    stroke-dashoffset: 160;
    animation: tg-draw 3.4s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }
  .tg-draw-1 {
    animation-delay: 0.25s;
  }
  .tg-draw-2 {
    animation-delay: 0.5s;
  }
  @keyframes tg-draw {
    0% {
      stroke-dashoffset: 160;
    }
    45%,
    85% {
      stroke-dashoffset: 0;
    }
    100% {
      stroke-dashoffset: -160;
    }
  }

  .tg-pulse {
    transform-origin: 34px 42px;
    animation: tg-pulse 2.6s ease-out infinite;
  }
  @keyframes tg-pulse {
    0% {
      transform: scale(0.7);
      opacity: 1;
    }
    70%,
    100% {
      transform: scale(1.5);
      opacity: 0;
    }
  }

  .tg-a {
    animation: tg-bob 4s ease-in-out infinite;
  }
  @keyframes tg-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-5px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tg-dash,
    .tg-draw,
    .tg-pulse,
    .tg-a {
      animation: none;
    }
    .tg-draw {
      stroke-dashoffset: 0;
    }
  }
</style>
