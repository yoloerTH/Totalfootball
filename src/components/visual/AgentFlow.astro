---
/**
 * An agentic workflow, running.
 *
 * The course teaches automation as well as the board, and automation is the
 * harder of the two to put on a page: a finished pipeline is invisible by
 * design. So this draws the thing itself — a trigger firing, an agent choosing
 * between tools, the result coming back, and nothing reaching the channel until
 * a human says yes — and animates the part that actually matters, which is that
 * **the agent decides**. The branch it takes changes between runs.
 *
 * WHY THERE IS A LAST NODE. The first version ended at three tools, one of
 * which was "Post it", so a model choosing to publish looked like the happy
 * path. The course's whole argument is the opposite: where a model may decide
 * and where it must not. The gate is now a node with a name, and every branch
 * has to go through it.
 *
 * Same technique as MiniBoard and StudioDeck, for the same reasons: pure SVG
 * plus CSS keyframes. No JS, no library, no layout cost, nothing to hydrate,
 * and it freezes to a readable still under reduced-motion. One shared
 * 12-second timeline drives every element so nothing can drift out of step.
 *
 * Deliberately NOT a screenshot of n8n. A screenshot dates the moment the tool
 * ships a redesign, it drags someone else's brand onto our page, and it shows a
 * workflow that is not ours. This is the same idea drawn in our own hand — the
 * paper stage, the dot grid, the gold and green, the house easing curve.
 */
interface Props {
  class?: string
  /** Decorative by default; pass a label to expose it to assistive tech. */
  title?: string
}

const { class: klass = '', title } = Astro.props

const GOLD = '#E6B23A'
const GREEN = '#08C16A'
const INK = 'currentColor'

const uid = `af-${Math.random().toString(36).slice(2, 8)}`

/**
 * Node geometry, in the 880x440 viewBox. Ports are derived from it and never
 * re-typed, so moving a node moves its wires.
 *
 * THE WIDTHS ARE SET BY THE LONGEST STRING IN EACH COLUMN, not by eye. Text
 * starts at x + 52 (past the icon chip) and there is no wrapping in SVG, so a
 * node narrower than its own label does not clip, it spills over the border and
 * onto the wire behind it: at 172 the agent's "Chooses the next move" ran into
 * the "no board" branch label. Anything added here has to be measured against
 * these, or the widths have to grow with it.
 */
interface Node {
  id: string
  x: number
  y: number
  w: number
  h: number
  label: string
  sub: string
  tint: string
  /** 24x24 glyph, drawn inside the node's icon chip. */
  glyph: string
}

const NODES: Node[] = [
  {
    id: 'trigger',
    x: 16,
    y: 208,
    w: 150,
    h: 78,
    label: 'Trigger',
    sub: 'A fixture lands',
    tint: GOLD,
    glyph: '<rect x="4" y="5" width="16" height="15" rx="3"/><path d="M4 10h16M9 3v4M15 3v4"/>',
  },
  {
    id: 'agent',
    x: 214,
    y: 196,
    w: 196,
    h: 102,
    label: 'Agent',
    sub: 'Chooses the next move',
    tint: GOLD,
    glyph: '<path d="M12 3v18M3 12h18M6 6l12 12M18 6L6 18"/>',
  },
  {
    id: 'toolA',
    x: 486,
    y: 96,
    w: 200,
    h: 72,
    label: 'Fetch the data',
    sub: 'Results, xG, line-ups',
    tint: GREEN,
    glyph: '<path d="M12 3v12M7 11l5 5 5-5M4 20h16"/>',
  },
  {
    id: 'toolB',
    x: 486,
    y: 205,
    w: 200,
    h: 72,
    label: 'Draft the board',
    sub: 'Phases, on the Studio',
    tint: GREEN,
    glyph: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M12 5v14"/><circle cx="7.5" cy="12" r="1.6"/>',
  },
  {
    id: 'toolC',
    x: 486,
    y: 314,
    w: 200,
    h: 72,
    label: 'Write the caption',
    sub: 'In the channel voice',
    tint: GREEN,
    glyph: '<path d="M4 7h16M4 12h16M4 17h9"/>',
  },
  {
    id: 'gate',
    x: 742,
    y: 193,
    w: 124,
    h: 96,
    label: 'Your yes',
    sub: 'before it goes out',
    tint: INK,
    glyph: '<path d="M4 12.5l5 5L20 6.5"/>',
  },
]

const byId = Object.fromEntries(NODES.map((n) => [n.id, n])) as Record<string, Node>
const rightPort = (n: Node) => ({ x: n.x + n.w, y: n.y + n.h / 2 })
const leftPort = (n: Node) => ({ x: n.x, y: n.y + n.h / 2 })

type Pt = { x: number; y: number }

/** The control offset a horizontal-tangent bezier uses, kept in one place so
    the curve and its midpoint can never be computed from different numbers. */
const bend = (from: Pt, to: Pt) => Math.max(44, (to.x - from.x) * 0.5)

/** A horizontal-tangent bezier, which is how every node editor draws a wire. */
function wire(from: Pt, to: Pt): string {
  const dx = bend(from, to)
  return `M ${from.x} ${from.y} C ${from.x + dx} ${from.y}, ${to.x - dx} ${to.y}, ${to.x} ${to.y}`
}

/** The point halfway along that curve, which is where a wire's label belongs.
    Cubic at t = 0.5 is (p0 + 3c1 + 3c2 + p3) / 8. */
function mid(from: Pt, to: Pt): Pt {
  const dx = bend(from, to)
  return {
    x: (from.x + 3 * (from.x + dx) + 3 * (to.x - dx) + to.x) / 8,
    y: (from.y + 3 * from.y + 3 * to.y + to.y) / 8,
  }
}

/**
 * Every wire on the canvas. `cls` is what ties a wire to its run of the shared
 * timeline; `label` is the condition the agent is weighing, which is the only
 * way a still frame can say that a choice was made here at all. They are kept
 * short because a wire label has the gap between two nodes to live in and
 * nothing more.
 */
const WIRES = [
  { from: rightPort(byId.trigger), to: leftPort(byId.agent), cls: 'af-w0', colour: GOLD, label: null },
  { from: rightPort(byId.agent), to: leftPort(byId.toolA), cls: 'af-out af-a', colour: GREEN, label: 'no numbers' },
  { from: rightPort(byId.agent), to: leftPort(byId.toolB), cls: 'af-out af-b', colour: GREEN, label: 'no board' },
  { from: rightPort(byId.agent), to: leftPort(byId.toolC), cls: 'af-out af-c', colour: GREEN, label: 'no caption' },
  { from: rightPort(byId.toolA), to: leftPort(byId.gate), cls: 'af-back af-a', colour: GREEN, label: null },
  { from: rightPort(byId.toolB), to: leftPort(byId.gate), cls: 'af-back af-b', colour: GREEN, label: null },
  { from: rightPort(byId.toolC), to: leftPort(byId.gate), cls: 'af-back af-c', colour: GREEN, label: null },
].map((w) => ({ ...w, d: wire(w.from, w.to), at: mid(w.from, w.to) }))
---

<svg
  viewBox="0 0 880 440"
  class={`block w-full text-ink ${klass}`}
  role={title ? 'img' : 'presentation'}
  aria-label={title}
  aria-hidden={title ? undefined : 'true'}
>
  <defs>
    {/* The canvas grain. A pattern rather than a thousand circles, masked so it
        fades out before the edges — the same treatment as the page's stage. */}
    <pattern id={`${uid}-dots`} width="22" height="22" patternUnits="userSpaceOnUse">
      <circle cx="1.5" cy="1.5" r="1.1" fill={INK} fill-opacity="0.11" />
    </pattern>
    <radialGradient id={`${uid}-fade`} cx="50%" cy="50%" r="62%">
      <stop offset="0%" stop-color="#fff" stop-opacity="1" />
      <stop offset="100%" stop-color="#fff" stop-opacity="0" />
    </radialGradient>
    <mask id={`${uid}-mask`}>
      <rect x="0" y="46" width="880" height="394" fill={`url(#${uid}-fade)`} />
    </mask>

    {/* The agent's halo while it is thinking. A soft radial, never a blur
        filter — the same rule the board follows, so this survives export. */}
    <radialGradient id={`${uid}-halo`} cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color={GOLD} stop-opacity="0.34" />
      <stop offset="70%" stop-color={GOLD} stop-opacity="0.07" />
      <stop offset="100%" stop-color={GOLD} stop-opacity="0" />
    </radialGradient>
  </defs>

  {/* ── the canvas ──────────────────────────────────────────────────── */}
  <rect x="0.5" y="0.5" width="879" height="439" rx="14" fill="rgb(var(--tf-paper))" stroke={INK} stroke-opacity="0.1" />
  <rect x="0" y="46" width="880" height="394" fill={`url(#${uid}-dots)`} mask={`url(#${uid}-mask)`} />

  {/* Canvas chrome. It costs four small marks and it is what makes the drawing
      read as a workflow that is running rather than a diagram of one. */}
  <g>
    <text x="20" y="29" font-size="14" font-weight="800" fill={INK} letter-spacing="-0.01em">
      Matchday pipeline
    </text>
    <text x="166" y="29" font-size="12" font-weight="600" fill={INK} fill-opacity="0.42">
      · runs on every fixture
    </text>
    <g>
      <rect x="768" y="12" width="92" height="24" rx="12" fill={GREEN} fill-opacity="0.12" />
      <circle class="af-live" cx="784" cy="24" r="4" fill={GREEN} />
      <text x="796" y="28.5" font-size="11.5" font-weight="800" fill={INK} fill-opacity="0.72">
        Running
      </text>
    </g>
    <line x1="0" y1="46" x2="880" y2="46" stroke={INK} stroke-opacity="0.1" />
  </g>

  {/* ── wires, under everything ─────────────────────────────────────── */}
  <g fill="none" stroke-linecap="round">
    {
      WIRES.map((w) => (
        <>
          <path d={w.d} stroke={INK} stroke-opacity="0.16" stroke-width="2" />
          {/*
            The travelling pulse. A dash the length of a short segment, with a
            gap the length of the whole path, walked along by dashoffset — the
            cheapest way to move something down a curve without JS and without
            measuring the path.
          */}
          <path
            class={`af-pulse ${w.cls}`}
            d={w.d}
            stroke={w.colour}
            stroke-width="3"
            stroke-dasharray="30 900"
          />
        </>
      ))
    }
  </g>

  {/* The conditions the agent is weighing, sat on their own wire the way a
      node editor labels a branch. Without them a viewer sees three wires; with
      them they see a decision. The paper backing is what stops the wire from
      running through the type. */}
  {
    WIRES.filter((w) => w.label).map((w) => (
      <g>
        <rect
          x={w.at.x - 34}
          y={w.at.y - 9}
          width="68"
          height="18"
          rx="9"
          fill="rgb(var(--tf-paper))"
          stroke={INK}
          stroke-opacity="0.1"
        />
        <text
          x={w.at.x}
          y={w.at.y + 3.5}
          text-anchor="middle"
          font-size="10"
          font-weight="700"
          fill={INK}
          fill-opacity="0.42"
        >
          {w.label}
        </text>
      </g>
    ))
  }

  {/* ── nodes ───────────────────────────────────────────────────────── */}
  {
    NODES.map((n) => {
      const isAgent = n.id === 'agent'
      const isGate = n.id === 'gate'
      const cls = {
        trigger: 'af-n0',
        agent: 'af-nagent',
        toolA: 'af-tool af-a',
        toolB: 'af-tool af-b',
        toolC: 'af-tool af-c',
        gate: 'af-ngate',
      }[n.id]
      return (
        <g>
          {isAgent && (
            <circle class="af-halo" cx={n.x + n.w / 2} cy={n.y + n.h / 2} r="112" fill={`url(#${uid}-halo)`} />
          )}

          <rect
            x={n.x}
            y={n.y}
            width={n.w}
            height={n.h}
            rx="12"
            fill="rgb(var(--tf-surface))"
            stroke={INK}
            stroke-opacity="0.14"
          />

          {/* The lit edge. This is the node's "active" tell, and it is a stroke
              rather than a fill so a node reads as active at any size. */}
          <rect
            class={`af-lit ${cls}`}
            x={n.x}
            y={n.y}
            width={n.w}
            height={n.h}
            rx="12"
            fill="none"
            stroke={isAgent ? GOLD : isGate ? INK : GREEN}
            stroke-width="2.2"
          />

          {/* Icon chip. A node with a mark on it reads as a step in a machine;
              a node with only words on it reads as a label. */}
          <rect
            x={n.x + 14}
            y={n.y + 14}
            width="28"
            height="28"
            rx="8"
            fill={n.tint}
            fill-opacity={isGate ? 0.1 : 0.16}
          />
          <g
            transform={`translate(${n.x + 16} ${n.y + 16}) scale(1)`}
            fill="none"
            stroke={n.tint}
            stroke-opacity={isGate ? 0.65 : 1}
            stroke-width="1.9"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <Fragment set:html={n.glyph} />
          </g>

          {/* The gate is the one narrow node — it is the end of the line, not a
              step — so its type stacks under the mark instead of beside it. */}
          <text
            x={isGate ? n.x + 14 : n.x + 52}
            y={n.y + (isGate ? 62 : 27)}
            font-size="15"
            font-weight="800"
            fill={INK}
            letter-spacing="-0.01em"
          >
            {n.label}
          </text>
          <text
            x={isGate ? n.x + 14 : n.x + 52}
            y={n.y + (isGate ? 80 : 44)}
            font-size="11.5"
            font-weight="600"
            fill={INK}
            fill-opacity="0.45"
          >
            {n.sub}
          </text>

          {/* The agent gets a third line, because "decides" is the claim and a
              claim deserves saying. */}
          {isAgent && (
            <>
              <line
                x1={n.x + 14}
                y1={n.y + 62}
                x2={n.x + n.w - 14}
                y2={n.y + 62}
                stroke={INK}
                stroke-opacity="0.1"
              />
              <text x={n.x + 14} y={n.y + 82} font-size="11.5" font-weight="700" fill={GOLD}>
                3 tools · 1 pick
              </text>
            </>
          )}

          {/* Ports, so it reads as a node graph and not as six boxes. */}
          {n.id !== 'trigger' && <circle cx={n.x} cy={n.y + n.h / 2} r="4.5" fill={INK} fill-opacity="0.22" />}
          {!isGate && <circle cx={n.x + n.w} cy={n.y + n.h / 2} r="4.5" fill={INK} fill-opacity="0.22" />}
        </g>
      )
    })
  }
</svg>

<style>
  /*
   * ONE 12-SECOND TIMELINE, three runs of four seconds each. Every run fires
   * the trigger, lights the agent, takes a DIFFERENT branch, brings the result
   * back and stops at the gate. The branch changing is the only claim this
   * drawing makes and the whole reason it is animated rather than a still.
   *
   * Percentages are of the full 12s, so one run is 33.33%. Within a run:
   *
   *   0 – 9%    the trigger fires and reaches the agent
   *   8 – 26%   the agent is lit: it is choosing
   *   12 – 21%  out along the chosen branch
   *   18 – 27%  the tool works
   *   22 – 31%  back from the tool
   *   27 – 33%  the gate — where it stops until a person says yes
   *
   * The three branches share one pair of keyframes and are separated by a 4s
   * and an 8s delay, which is why adding a fourth tool would be a one-line
   * change rather than a rewrite.
   */
  .af-pulse,
  .af-lit,
  .af-halo,
  .af-live {
    animation-duration: 12s;
    animation-iteration-count: infinite;
    /* The house curve, the same one the board's motion uses. */
    animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  }

  .af-pulse {
    stroke-dashoffset: 30;
    opacity: 0;
  }
  .af-lit,
  .af-halo {
    opacity: 0;
  }

  .af-w0 { animation-name: af-travel-in; }
  .af-n0 { animation-name: af-flash-in; }
  .af-nagent { animation-name: af-flash-agent; }
  .af-halo { animation-name: af-flash-agent; }
  .af-ngate { animation-name: af-flash-gate; }
  .af-out { animation-name: af-travel-out; }
  .af-back { animation-name: af-travel-back; }
  .af-tool { animation-name: af-flash-tool; }
  .af-live { animation-name: af-live; }

  /* Which run each branch belongs to. */
  .af-b { animation-delay: 4s; }
  .af-c { animation-delay: 8s; }

  /* The trigger fires at the top of every run, so its keyframes carry all
     three flashes rather than relying on a delay. */
  @keyframes af-travel-in {
    0% { stroke-dashoffset: 30; opacity: 0; }
    1% { opacity: 1; }
    9% { stroke-dashoffset: -300; opacity: 1; }
    12% { opacity: 0; }
    33.33% { stroke-dashoffset: -300; opacity: 0; }
    33.34% { stroke-dashoffset: 30; opacity: 1; }
    42.33% { stroke-dashoffset: -300; opacity: 1; }
    45.33% { opacity: 0; }
    66.66% { stroke-dashoffset: -300; opacity: 0; }
    66.67% { stroke-dashoffset: 30; opacity: 1; }
    75.66% { stroke-dashoffset: -300; opacity: 1; }
    78.66%, 100% { opacity: 0; }
  }

  @keyframes af-flash-in {
    0% { opacity: 0; }
    2% { opacity: 1; }
    10% { opacity: 0; }
    33.33% { opacity: 0; }
    35.33% { opacity: 1; }
    43.33% { opacity: 0; }
    66.66% { opacity: 0; }
    68.66% { opacity: 1; }
    76.66%, 100% { opacity: 0; }
  }

  /* The agent is lit for the whole decision, which is the longest beat here —
     a pipeline that thinks is the point being made. */
  @keyframes af-flash-agent {
    0%, 7% { opacity: 0; }
    9% { opacity: 1; }
    24% { opacity: 1; }
    27% { opacity: 0; }
    33.33%, 40.33% { opacity: 0; }
    42.33% { opacity: 1; }
    57.33% { opacity: 1; }
    60.33% { opacity: 0; }
    66.66%, 73.66% { opacity: 0; }
    75.66% { opacity: 1; }
    90.66% { opacity: 1; }
    93.66%, 100% { opacity: 0; }
  }

  /* Each branch travels once, in its own third of the timeline. */
  @keyframes af-travel-out {
    0%, 12% { stroke-dashoffset: 30; opacity: 0; }
    13% { opacity: 1; }
    21% { stroke-dashoffset: -340; opacity: 1; }
    24%, 100% { opacity: 0; }
  }

  @keyframes af-travel-back {
    0%, 22% { stroke-dashoffset: 30; opacity: 0; }
    23% { opacity: 1; }
    31% { stroke-dashoffset: -340; opacity: 1; }
    34%, 100% { opacity: 0; }
  }

  @keyframes af-flash-tool {
    0%, 17% { opacity: 0; }
    19% { opacity: 1; }
    28% { opacity: 1; }
    31%, 100% { opacity: 0; }
  }

  /* The gate lights in every run and holds a beat longer than anything else:
     it is where the pipeline waits for a person. */
  @keyframes af-flash-gate {
    0%, 27% { opacity: 0; }
    29% { opacity: 1; }
    33% { opacity: 1; }
    33.33% { opacity: 0; }
    60.33% { opacity: 0; }
    62.33% { opacity: 1; }
    66.33% { opacity: 1; }
    66.66% { opacity: 0; }
    93.66% { opacity: 0; }
    95.66% { opacity: 1; }
    99.66%, 100% { opacity: 0; }
  }

  /* The status dot. Slow, so it reads as a heartbeat and not as an alarm. */
  @keyframes af-live {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.28; }
  }

  /*
   * Reduced motion: hold the middle of a run — trigger fired, agent lit, the
   * board branch taken and its tool working. Still a correct and readable
   * diagram of the idea, which is the bar MiniBoard sets.
   */
  @media (prefers-reduced-motion: reduce) {
    .af-pulse,
    .af-lit,
    .af-halo,
    .af-live {
      animation: none;
    }
    .af-halo,
    .af-nagent,
    .af-live {
      opacity: 1;
    }
    .af-b {
      opacity: 1;
    }
    .af-pulse.af-b {
      stroke-dashoffset: -170;
    }
  }
</style>
