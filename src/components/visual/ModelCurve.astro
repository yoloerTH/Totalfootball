---
/**
 * A probability distribution with the value tail shaded gold and a scan line
 * sweeping across it.
 *
 * Ported in spirit from the ModelCurve device used in the videos' Telegram CTA,
 * and it is here for the same reason it was chosen there: pricing the
 * distribution and taking the edge in the tail is literally what the system
 * does, so the picture is accurate rather than symbolic. A brain or a robot
 * icon would need recognising; this reads at a glance.
 */
interface Props {
  class?: string
  /** Where the market's price sits; everything right of it is the edge. */
  cut?: number
}

const { class: klass = '', cut = 0.62 } = Astro.props

const GOLD = '#E6B23A'
const INK = 'currentColor'

const W = 520
const H = 240
const BASE = H - 34

// A plain normal curve, sampled. Drawn from maths so the shape is honest.
const mu = 0.46
const sigma = 0.15
const bell = (t: number) => Math.exp(-((t - mu) ** 2) / (2 * sigma * sigma))

const pts = Array.from({ length: 121 }, (_, i) => {
  const t = i / 120
  return { x: t * W, y: BASE - bell(t) * (BASE - 26) }
})

const line = pts.map((p, i) => `${i === 0 ? 'M' : 'L'}${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(' ')

const cutX = cut * W
const tail = pts.filter((p) => p.x >= cutX)
const tailArea =
  `M${cutX.toFixed(1)},${BASE} ` +
  tail.map((p) => `L${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(' ') +
  ` L${W},${BASE} Z`

const uid = `mc-${Math.random().toString(36).slice(2, 8)}`
---

<svg viewBox={`0 0 ${W} ${H}`} class={klass} aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={`${uid}-tail`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color={GOLD} stop-opacity="0.55" />
      <stop offset="100%" stop-color={GOLD} stop-opacity="0.08" />
    </linearGradient>
    <clipPath id={`${uid}-clip`}>
      <rect x="0" y="0" width={W} height={H} />
    </clipPath>
  </defs>

  {/* baseline + ticks */}
  <line x1="0" y1={BASE} x2={W} y2={BASE} stroke={INK} stroke-opacity="0.18" stroke-width="1.5" />
  {
    Array.from({ length: 9 }, (_, i) => (
      <line
        x1={(i / 8) * W}
        y1={BASE}
        x2={(i / 8) * W}
        y2={BASE + 6}
        stroke={INK}
        stroke-opacity="0.14"
        stroke-width="1.5"
      />
    ))
  }

  {/* the edge */}
  <path d={tailArea} fill={`url(#${uid}-tail)`} class="mc-tail" />

  {/* the distribution */}
  <path d={line} fill="none" stroke={INK} stroke-width="2.5" stroke-linecap="round" class="mc-line" />

  {/* the market's price */}
  <line
    x1={cutX}
    y1="20"
    x2={cutX}
    y2={BASE}
    stroke={INK}
    stroke-opacity="0.5"
    stroke-width="1.5"
    stroke-dasharray="5 5"
  />
  <text
    x={cutX + 10}
    y="32"
    font-size="11"
    font-weight="700"
    letter-spacing="0.14em"
    fill={INK}
    fill-opacity="0.55"
    font-family="Inter Variable, Inter, sans-serif">MARKET</text
  >
  <text
    x={W - 8}
    y={BASE - 14}
    text-anchor="end"
    font-size="11"
    font-weight="800"
    letter-spacing="0.14em"
    font-family="Inter Variable, Inter, sans-serif"
    class="fill-[#B4841F] dark:fill-gold">THE EDGE</text
  >

  {/* scan */}
  <g clip-path={`url(#${uid}-clip)`}>
    <rect x="-2" y="0" width="2" height={BASE} fill={GOLD} opacity="0.75" class="mc-scan" />
  </g>
</svg>

<style>
  .mc-line {
    stroke-dasharray: 900;
    stroke-dashoffset: 900;
    animation: mc-draw 2.4s cubic-bezier(0.16, 1, 0.3, 1) 0.2s forwards;
  }
  @keyframes mc-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  .mc-tail {
    opacity: 0;
    animation: mc-fade 1.2s ease-out 1.6s forwards;
  }
  @keyframes mc-fade {
    to {
      opacity: 1;
    }
  }

  .mc-scan {
    animation: mc-scan 5.5s cubic-bezier(0.5, 0, 0.5, 1) 2.4s infinite;
  }
  @keyframes mc-scan {
    0% {
      transform: translateX(0);
      opacity: 0;
    }
    8% {
      opacity: 0.75;
    }
    72% {
      opacity: 0.75;
    }
    80%,
    100% {
      transform: translateX(524px);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mc-line {
      stroke-dashoffset: 0;
      animation: none;
    }
    .mc-tail {
      opacity: 1;
      animation: none;
    }
    .mc-scan {
      display: none;
    }
  }
</style>
