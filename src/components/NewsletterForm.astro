---
/**
 * Email capture. One component, used by the footer, the popup and the course
 * waitlist. `source` tags the row so we can later tell which library pages
 * actually convert (docs/SPEC.md §9).
 *
 * Progressive enhancement: it is a real <form> with a real action, so it works
 * with JS disabled. Script intercepts submit only to avoid a page navigation.
 */
interface Props {
  source: string
  /** Compact single-line treatment for tight spaces. */
  compact?: boolean
  cta?: string
  class?: string
}

const { source, compact = false, cta = 'Subscribe', class: klass = '' } = Astro.props
const id = `nl-${Math.random().toString(36).slice(2, 8)}`
---

<form
  class:list={['tf-newsletter w-full', klass]}
  method="POST"
  action="/api/subscribe"
  data-source={source}
>
  <input type="hidden" name="source" value={source} />

  {/* Honeypot. Bots fill it; humans never see it. Cheaper and less hostile
      than a captcha, and it keeps the form zero-dependency. */}
  <div class="absolute left-[-9999px]" aria-hidden="true">
    <label for={`${id}-company`}>Company</label>
    <input id={`${id}-company`} name="company" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div class:list={['flex gap-2', compact ? 'flex-row' : 'flex-col sm:flex-row']}>
    <label for={id} class="sr-only">Email address</label>
    <input
      id={id}
      name="email"
      type="email"
      required
      autocomplete="email"
      placeholder="you@email.com"
      class="min-w-0 flex-1 rounded-full border border-ink-hair bg-surface/70 px-5 py-3 text-sm
             text-ink placeholder:text-ink-faint focus:border-ink/25 focus:outline-none
             focus-visible:outline-2"
    />
    <button type="submit" class="btn-primary shrink-0">{cta}</button>
  </div>

  <p class="tf-nl-msg mt-3 hidden text-sm" role="status" aria-live="polite"></p>
  <p class="mt-3 text-xs leading-relaxed text-ink-faint">
    One email a week. Unsubscribe any time.
  </p>
</form>

<script>
  // Bound once per page for every instance of the form.
  document.querySelectorAll<HTMLFormElement>('form.tf-newsletter').forEach((form) => {
    const msg = form.querySelector<HTMLElement>('.tf-nl-msg')
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')

    const say = (text: string, ok: boolean) => {
      if (!msg) return
      msg.textContent = text
      msg.classList.remove('hidden')
      msg.style.color = ok ? '#06A659' : '#B4341F'
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault()
      if (!button) return

      const data = new FormData(form)
      // Honeypot tripped, so pretend it worked and drop it.
      if (data.get('company')) {
        say('Thanks, check your inbox.', true)
        form.reset()
        return
      }

      const label = button.textContent
      button.disabled = true
      button.textContent = 'Sending…'

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email: data.get('email'),
            source: data.get('source'),
          }),
        })
        if (!res.ok) throw new Error(String(res.status))
        say('Thanks, you are on the list.', true)
        // The conversion, not the attempt. A tracked click on the button
        // counts people who pressed it; this counts people who got on the
        // list, which is the number the daily report is actually about.
        window.tfTrack?.(`signup:${data.get('source') ?? 'unknown'}`)
        // Announced so a surface that WRAPS this form can respond to a
        // confirmed insert — the popup uses it to stop offering. Deliberately
        // fired here and not on submit: a submit is an attempt, and a popup
        // that congratulates an attempt will congratulate a network error.
        form.dispatchEvent(new CustomEvent('tf:subscribed', { bubbles: true }))
        form.reset()
      } catch {
        say('That did not go through. Try again in a moment.', false)
      } finally {
        button.disabled = false
        button.textContent = label
      }
    })
  })
</script>
