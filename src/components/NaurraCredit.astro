---
/**
 * The house credit: "Designed by NAURRA AI".
 *
 * Same badge Naurra puts on the sites it designs (see aiparastatika.gr), but
 * re-cut for the paper stage instead of copied: a hairline pill on the site's
 * own surface colour rather than the dark slate chip, with the accent moving
 * green → gold on hover, which is this brand's gradient and happens to be the
 * mark's own palette too.
 *
 * Two placements, one component:
 *  · variant="float"  the corner badge, floating over the reading area
 *  · variant="inline" the permanent credit that lives in the footer
 *
 * They are meant to work as a pair. The floating badge tucks itself away as
 * soon as the footer scrolls into view, so it never sits on top of the footer's
 * own links, and the inline credit takes over from there. That handover is the
 * reason the badge can stay small and quiet rather than shouting to be seen.
 *
 * The mark is a raster on purpose: it is a rendered orb with soft glow, not a
 * geometric mark like ours, so an SVG port would be a lie. public/naurra-mark.png
 * is the 2160px original downsampled to 128px, which is 4× the largest size it
 * is ever drawn at.
 */
interface Props {
  variant?: 'float' | 'inline'
  class?: string
}

const { variant = 'float', class: klass = '' } = Astro.props

const HREF = 'https://naurra.ai/company/'
---

{
  variant === 'float' ? (
    <div class:list={['naurra-dock fixed z-30 print:hidden', klass]}>
      <a
        href={HREF}
        target="_blank"
        rel="noopener"
        aria-label="Designed by Naurra AI"
        class="naurra-float group inline-flex items-center gap-2 rounded-full border border-ink-hair bg-surface/80 py-1 pl-1 pr-3 shadow-paper backdrop-blur-md sm:gap-2.5 sm:py-1.5 sm:pl-1.5 sm:pr-4"
      >
        <span class="naurra-orb grid h-6 w-6 shrink-0 place-items-center rounded-full sm:h-7 sm:w-7">
          <img
            src="/naurra-mark.png"
            alt=""
            width="28"
            height="28"
            loading="lazy"
            decoding="async"
            class="h-full w-full object-contain"
          />
        </span>
        <span class="flex flex-col text-left leading-none">
          <span class="text-[8px] font-semibold uppercase tracking-[0.18em] text-ink-faint transition-colors group-hover:text-ink-soft sm:text-[8.5px] sm:tracking-[0.2em]">
            Designed by
          </span>
          <span class="mt-[2px] text-[10px] font-bold uppercase tracking-[0.12em] text-ink sm:mt-[3px] sm:text-[11px] sm:tracking-[0.14em]">
            Naurra AI
          </span>
        </span>
      </a>
    </div>
  ) : (
    <a
      href={HREF}
      target="_blank"
      rel="noopener"
      class:list={[
        'group inline-flex items-center gap-2.5 text-xs text-ink-faint transition-colors hover:text-ink-soft',
        klass,
      ]}
    >
      <span class="naurra-orb grid h-[22px] w-[22px] shrink-0 place-items-center rounded-full">
        <img
          src="/naurra-mark.png"
          alt=""
          width="22"
          height="22"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-contain"
        />
      </span>
      <span>
        Designed by{' '}
        <strong class="font-semibold uppercase tracking-[0.1em] text-ink-soft transition-colors group-hover:text-ink">
          Naurra AI
        </strong>
      </span>
    </a>
  )
}

<style>
  /*
   * The orb is a light-emitting mark on black, so it needs a dark ground in
   * both themes: on paper it would otherwise read as a smudge. The ring is the
   * brand green, and it warms to gold on hover — the same two stops as
   * .grad-text, used as a state change rather than a fill.
   */
  .naurra-orb {
    background: radial-gradient(circle at 50% 42%, #101c17 0%, #050806 76%);
    box-shadow: 0 0 0 1px rgb(8 193 106 / 0.32), 0 0 12px -2px rgb(8 193 106 / 0.35);
    transition: box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .group:hover .naurra-orb {
    box-shadow: 0 0 0 1px rgb(230 178 58 / 0.55), 0 0 16px -2px rgb(230 178 58 / 0.5);
  }

  /*
   * The badge arrives late and from below, after the page has settled and the
   * reader has had the content first. Kept on the dock rather than the link so
   * the animation's fill state can never fight the tuck transition below.
   */
  .naurra-dock {
    animation: naurra-in 0.8s cubic-bezier(0.16, 1, 0.3, 1) 1.1s both;
    /*
     * Positioned here rather than with utilities so the phone's home indicator
     * can be accounted for: on an iPhone the bottom inset is ~34px, and without
     * this the badge sits under the gesture bar in Safari's full-height view.
     */
    right: 1rem;
    bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
  }
  @media (min-width: 640px) {
    .naurra-dock {
      right: 1.25rem;
      bottom: calc(1.25rem + env(safe-area-inset-bottom, 0px));
    }
  }
  @keyframes naurra-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* `translate` rather than `transform`, which the entrance animation owns. */
  .naurra-float {
    transition: opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      translate 0.45s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.35s ease, box-shadow 0.35s ease;
  }
  .naurra-float:hover {
    translate: 0 -1px;
    border-color: rgb(230 178 58 / 0.45);
    box-shadow: var(--tf-shadow-lift);
  }
  .naurra-float.is-tucked {
    opacity: 0;
    translate: 0 12px;
    pointer-events: none;
  }
</style>

<script>
  // Hand the credit over to the footer copy. Progressive by design: with no JS
  // the badge simply stays put, which is the pre-existing behaviour everywhere
  // else this badge is used.
  const badge = document.querySelector<HTMLElement>('.naurra-float')
  const footer = document.querySelector('footer')
  if (badge && footer && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      ([entry]) => badge.classList.toggle('is-tucked', entry.isIntersecting),
      // A little before the footer's top edge, so the badge is already gone by
      // the time the footer's own links are under it.
      { rootMargin: '0px 0px -40px 0px' }
    )
    io.observe(footer)
  }
</script>
