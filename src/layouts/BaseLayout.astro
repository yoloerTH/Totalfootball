---
/**
 * The single SEO surface for the site. Ported from voice-ai-client's
 * BaseLayout.astro, which is already correct (canonical normalisation, OG,
 * Twitter, robots directives, JSON-LD) and adapted to the Total Football
 * entity.
 *
 * Rules this file enforces so no page has to remember them:
 *  · canonicals always absolute and always trailing-slashed
 *  · one Organization + one WebSite graph, site-wide
 *  · page-specific structured data passed in, never inlined in pages
 */
import '@fontsource-variable/inter'
/**
 * The latin subset, imported as a URL so Vite emits it and hashes it. docs/SPEC.md
 * §7 promised a preloaded font and the stylesheet import alone does not give one:
 * the browser has to parse the CSS before it discovers the file, which puts the
 * font one full round trip behind the text that needs it.
 *
 * Latin only, deliberately. The other six subsets in the family are gated behind
 * `unicode-range` and are never fetched by an English page, so preloading them
 * would be pure waste on the critical path.
 */
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url'
import '../styles/global.css'
import { SITE, SITE_URL, ENTITY, abs, sameAs } from '../lib/site'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import Analytics from '../components/Analytics.astro'
import NaurraCredit from '../components/NaurraCredit.astro'
import JoinPopup from '../components/JoinPopup.astro'

interface Props {
  title?: string
  description?: string
  /** Path like '/library/back-four/', absolutised for the canonical. */
  path?: string
  image?: string
  imageAlt?: string
  /**
   * Intrinsic size of `image`. Defaults to the 1200×630 of /og-default.png.
   *
   * These are not decoration: a scraper that cannot fetch the image trusts them
   * to reserve the card, and they were previously hardcoded at 1200×630 while
   * the library template was already sending 720×1104 portrait boards. Any page
   * that overrides `image` must override these with it.
   */
  imageWidth?: number
  imageHeight?: number
  type?: 'website' | 'article'
  publishedTime?: string
  modifiedTime?: string
  structuredData?: Record<string, any>[]
  /**
   * The trail from the homepage to here, EXCLUDING home and excluding this
   * page's own crumb — both are added below, so a page states only the middle.
   * Emitted as BreadcrumbList, which is what puts the trail under the result in
   * Google rather than a bare URL.
   *
   * Not rendered on the page. The visible back-link on a system page is one
   * word in context and the right treatment for a reader; a full visible trail
   * on a four-level site is furniture. Structured data has no such cost.
   */
  breadcrumbs?: { name: string; path: string }[]
  noindex?: boolean
  /** Suppress the site chrome (used by bare/landing treatments). */
  bare?: boolean
}

const {
  title,
  description = SITE.description,
  path = '/',
  image = '/og-default.png',
  imageAlt = 'Total Football: football tactics as diagrams',
  imageWidth = 1200,
  imageHeight = 630,
  type = 'website',
  publishedTime,
  modifiedTime,
  structuredData = [],
  breadcrumbs = [],
  noindex = false,
  bare = false,
} = Astro.props

// Titles are composed here so no page can drift from the pattern.
const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · ${SITE.tagline}`
const canonical = abs(path)
const ogImage = image.startsWith('http') ? image : `${SITE_URL}${image}`

// A real registered company, address and contact are among the few entity
// signals Google can actually verify, and entity strength is the bottleneck the
// naurra.ai audit identified. Worth stating properly rather than minimally.
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  legalName: ENTITY.legalName,
  url: SITE_URL,
  logo: `${SITE_URL}/logo.png`,
  description: SITE.description,
  identifier: {
    '@type': 'PropertyValue',
    propertyID: 'Cyprus Company Registration Number',
    value: ENTITY.registration,
  },
  address: {
    '@type': 'PostalAddress',
    streetAddress: ENTITY.street,
    addressLocality: ENTITY.locality,
    postalCode: ENTITY.postalCode,
    addressCountry: ENTITY.country,
  },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'Customer support',
    email: ENTITY.email,
  },
  parentOrganization: { '@type': 'Organization', name: 'Naurra.ai', url: 'https://naurra.ai' },
  ...(sameAs.length ? { sameAs } : {}),
}

/**
 * The trail, as Schema.org sees it.
 *
 * Built here rather than in each page so the two rules that make it valid
 * cannot be forgotten: home is always the first item, this page is always the
 * last, and `position` counts from 1 with no gaps. A page that listed its own
 * crumb would double it the day someone also passed the parent.
 *
 * Only emitted when a page actually has a middle. On a top-level page the trail
 * is "Home › this", which tells a search engine nothing it did not already know
 * from the URL.
 */
const crumbSchema =
  breadcrumbs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { name: 'Home', path: '/' },
          ...breadcrumbs,
          { name: title ?? SITE.name, path },
        ].map((crumb, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: crumb.name,
          item: abs(crumb.path),
        })),
      }
    : null

const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE_URL,
  description: SITE.description,
  publisher: { '@type': 'Organization', name: SITE.name },
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${SITE_URL}/library/?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
}
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/*
      Exactly ONE theme-color meta, deliberately. Splitting it into a
      light/dark pair looks like an improvement and is not: three separate
      scripts (the inline theme script below, Header.astro, and the studio's
      ThemeToggle) all reach for `meta[name="theme-color"]` and get the FIRST
      match, so a pair means every one of them writes the light entry and a
      night reader's browser chrome never changes. The inline script below runs
      before the body paints and sets the right value, which is what a
      media-query pair would have been for.
    */}
    <meta name="theme-color" content="#F4F4F2" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    {
      noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta
          name="robots"
          content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
        />
      )
    }
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Total Football: new systems"
      href={`${SITE_URL}/rss.xml`}
    />

    {/* Open Graph */}
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:type" content={ogImage.endsWith('.png') ? 'image/png' : 'image/jpeg'} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.ogLocale} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
    {crumbSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(crumbSchema)} />}
    {
      structuredData.map((data) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />
      ))
    }

    {/*
      Runs before the body paints, which is the whole point: reading the stored
      theme after first paint would flash a white page at a night-mode reader.
      It also marks the document as scripted so CSS can opt into reveal
      animations without ever hiding content from crawlers or no-JS visitors.

      Note there is no prefers-color-scheme fallback. Light is the brand default
      and stays the default until someone chooses otherwise.

      The theme list is duplicated from src/lib/theme.ts because this runs
      inline, before any module loads — that is the price of not flashing.
      Anything not in it falls through to light, so a retired theme id left in
      someone's storage is a shrug rather than an unstyled page.
    */}
    <script is:inline>
      ;(function () {
        var root = document.documentElement
        root.classList.add('js')
        var PAPER = {
          dark: '#0A0C0B',
          pitch: '#15512D',
          'pitch-night': '#081A11',
        }
        try {
          var saved = localStorage.getItem('tf_theme')
          if (saved && PAPER[saved]) {
            root.setAttribute('data-theme', saved)
            var m = document.querySelector('meta[name="theme-color"]')
            if (m) m.setAttribute('content', PAPER[saved])
          }
        } catch (e) {}
        // Transitions are enabled only after the initial theme is settled, so
        // the first paint never animates.
        requestAnimationFrame(function () {
          root.classList.add('theme-ready')
        })
      })()
    </script>
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-ink focus:px-5 focus:py-2 focus:text-sm focus:text-paper"
      >Skip to content</a
    >

    {!bare && <Header />}
    <main id="main">
      <slot />
    </main>
    {!bare && <Footer />}
    {/* Corner badge; the matching permanent credit sits in the footer. */}
    {!bare && <NaurraCredit />}

    {/* Bottom-LEFT, opposite the credit badge. Arms itself on scroll depth or
        exit intent; see the component for the SPEC §9 rules it implements. */}
    {!bare && <JoinPopup />}

    <Analytics />

    <script>
      // Scroll reveal. Purely decorative: elements are already visible unless
      // the document is scripted, and reduced-motion users get them at once.
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]')
      if (reduce || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-in'))
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return
              const el = entry.target as HTMLElement
              const delay = Number(el.dataset.revealDelay ?? 0)
              window.setTimeout(() => el.classList.add('is-in'), delay)
              io.unobserve(el)
            })
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
        )
        items.forEach((el) => io.observe(el))
      }
    </script>
  </body>
</html>
