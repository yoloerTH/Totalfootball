---
/**
 * /course/ is waitlist only for now (docs/SPEC.md §11).
 *
 * The page is deliberately honest that it is not built yet: a waitlist that
 * pretends to be a product converts once and burns the list. The outline below
 * describes work that genuinely exists: the board engine, the two video
 * styles, and the measured pacing rules, so nothing here is a promise we
 * cannot keep.
 *
 * TODO(thanos): "who is it for" in one line, then this copy gets tightened
 * around it. Pricing stays off the page until the list says what it should be.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import NewsletterForm from '../components/NewsletterForm.astro'
import { abs } from '../lib/site'

const modules = [
  {
    n: '01',
    title: 'The two styles',
    body: 'The tactics board and the story short are different crafts. One teaches a system with choreography and no narration; the other carries a career or a night through portraits, type and pacing. You build one of each.',
  },
  {
    n: '02',
    title: 'The board engine',
    body: 'A reusable, scale-accurate pitch with tokens, a ball locked to the carrier, a follow-camera, and role cues that reassign themselves as the ball moves. Once this exists, a new breakdown is choreography rather than construction.',
  },
  {
    n: '03',
    title: 'Choreography',
    body: 'Why an eased fast-then-slow move reads as professional and a linear one does not. Holding a beat, staggering reveals so value keeps arriving, and the single most common failure: showing everything in four seconds and then sitting still.',
  },
  {
    n: '04',
    title: 'Sound without a licence',
    body: 'Synthesising your own effect kit, mapping cues tightly to motion, and ducking a bed under the transients. Copyright-safe by construction, which matters more in football than in any other niche.',
  },
  {
    n: '05',
    title: 'What the numbers actually say',
    body: 'The pacing rules in this course are not taste. They came out of measuring 88 published shorts: where attention is lost, which second decides it, and why a whole-team system outperforms a technique clinic by a factor of seven.',
  },
  {
    n: '06',
    title: 'Shipping',
    body: 'Export settings, the safe zones each platform crops, caption placement, and the trim discipline that turned out to matter more than anything done in the render.',
  },
]

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Course', item: abs('/course/') }],
}
---

<BaseLayout
  title="The course: how these videos get made"
  description="The full pipeline behind Total Football: the board engine, the choreography, and the pacing rules measured across 88 published shorts. Join the waitlist."
  path="/course/"
  structuredData={[breadcrumb]}
>
  <section class="stage border-b border-ink-hair">
    <div class="shell py-20 md:py-28">
      <div class="max-w-[46rem]">
        <p class="micro mb-7" data-reveal="fade">In production</p>
        <h1 class="text-display font-black" data-reveal="clip" data-reveal-delay="80">
          How these are<br /><span class="grad-text">actually made.</span>
        </h1>
        <p class="mt-9 max-w-prose text-xl leading-[1.6] text-ink/85">
          Not a motion-graphics course with a football example bolted on. The specific pipeline that
          produced this channel: the engine, the choreography, and the pacing rules that came out of
          measuring what people actually watched.
        </p>

        <div class="mt-11 max-w-xl">
          <NewsletterForm source="course-waitlist" cta="Join the waitlist" />
        </div>
      </div>
    </div>
  </section>

  <section class="shell py-20 md:py-28">
    <div class="mb-14 max-w-prose">
      <p class="micro mb-6">The outline</p>
      <h2 class="text-title font-black" data-reveal="clip">Six parts, one finished short at the end.</h2>
      <p class="mt-5 text-[17px] leading-relaxed text-ink-soft">
        Subject to change while it is being built, and the waitlist gets told when it does.
      </p>
    </div>

    <ol class="grid gap-px overflow-hidden rounded-3xl bg-ink-hair md:grid-cols-2">
      {
        modules.map((m, i) => (
          <li class="bg-paper p-8 transition-colors duration-300 hover:bg-white/70 md:p-10" data-reveal="rise" data-reveal-delay={i * 70}>
            <span class="mb-5 block bg-tf-gradient bg-clip-text text-2xl font-black tabular-nums text-transparent">
              {m.n}
            </span>
            <h3 class="text-xl font-black leading-tight">{m.title}</h3>
            <p class="mt-3 text-[15px] leading-relaxed text-ink-soft">{m.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="border-t border-ink-hair">
    <div class="shell py-20">
      <div class="grid gap-10 md:grid-cols-[1fr_auto] md:items-end">
        <div class="max-w-prose">
          <p class="micro mb-5">No date yet</p>
          <h2 class="text-section font-black">
            The list decides what this costs and when it ships.
          </h2>
          <p class="mt-4 text-[15px] leading-relaxed text-ink-soft">
            No launch spam. You will get one email when there is something real to look at.
          </p>
        </div>
        <div class="w-full max-w-md shrink-0">
          <NewsletterForm source="course-waitlist" cta="Join the waitlist" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
