---
/**
 * The studio, on a scratch system.
 *
 * Signed-in only. `StudioMount` sends anyone else to /studio/login/ and brings
 * them back here afterwards, so this page has no signed-out state of its own to
 * design. It was an open front door for two sessions; that call was reversed
 * (user, 2026-08-13) and the landing page at /studio/ is the front door now.
 *
 * The island is `client:only` rather than hydrated from server-rendered HTML
 * because the system it edits is fetched from the coach's account, which needs
 * a session that does not exist at build time. Server-rendering a board built
 * from a different system than the one the browser is about to load would flash
 * the wrong shape.
 */
import BaseLayout from '../../layouts/BaseLayout.astro'
import StudioMount from '../../studio/editor/StudioMount'
---

<BaseLayout
  title="Studio"
  description="Build a tactical presentation on the Total Football board: pick a pitch, a shape and your colours, then pose it act by act."
  path="/studio/new/"
  noindex
  bare
>
  <StudioMount client:only="react" />
</BaseLayout>
