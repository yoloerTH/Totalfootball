---
/**
 * The Studio's front door.
 *
 * This is the one page under /studio/ that is PUBLIC and INDEXED. Everything
 * else there is noindex, either because it is a tool with no content (the
 * editor), or because it cannot be rendered without knowing who is asking (the
 * portal, settings, sign-in). See docs/STUDIO.md.
 *
 * Structure follows docs/SPEC.md §4 like the homepage: each section ends in
 * exactly one CTA, and no section competes with itself. Every CTA on this page
 * points at the same place.
 *
 * THE HERO IS THE TOOL BEING USED. The single hardest thing to explain about
 * this product in words is the thing it does — you move a player and the
 * movement between where they were and where they are is the phase. StudioDeck
 * shows exactly that gesture, in pure SVG and CSS with no JS and no layout
 * cost. Showing it beats any headline written about it.
 *
 * It used to be MiniBoard, which is the HOMEPAGE's hero. Two landing pages
 * sharing one drawing made this page read as a copy of that one, and left the
 * site with no picture of the actual product anywhere on it.
 */
import BaseLayout from '../../layouts/BaseLayout.astro'
import StudioDeck from '../../components/visual/StudioDeck.astro'
import PoseToFilm from '../../components/visual/PoseToFilm.astro'
import StepGlyph from '../../components/visual/StepGlyph.astro'
import BoardWall from '../../components/visual/BoardWall.astro'
import SystemCard from '../../components/library/SystemCard.astro'
import Faq from '../../components/Faq.astro'
import { Board } from '../../studio/board/Board'
import { PITCH_VIEW_LIST, aspect, viewFor } from '../../studio/board/pitch'
import { FORMATIONS } from '../../studio/formations'
import { resolveAct } from '../../studio/tween'
import { GEAR } from '../../studio/gear'
import { TEMPLATES } from '../../studio/templates'
import type { System } from '../../studio/schema'
import { SYSTEMS } from '../../data/systems'
import { faqGroup } from '../../data/faq'
import { WHATS_NEW } from '../../data/whatsnew'
import sacchi from '../../../content/systems/sacchis-25-metres.json'
import { SITE_URL } from '../../lib/site'

const featured = SYSTEMS.slice(0, 3)

/**
 * NUMBERS ON THIS PAGE ARE COUNTED, NEVER TYPED.
 *
 * The page said "twenty-four formations" for three weeks after the shapes went
 * to twenty-six, because the sentence was written by hand and the catalogue was
 * not. Anything countable below is derived from the module that owns it, so the
 * copy cannot go stale without the build going with it.
 */
const WORDS = [
  'zero','one','two','three','four','five','six','seven','eight','nine','ten',
  'eleven','twelve','thirteen','fourteen','fifteen','sixteen','seventeen','eighteen','nineteen','twenty',
  'twenty-one','twenty-two','twenty-three','twenty-four','twenty-five','twenty-six','twenty-seven',
  'twenty-eight','twenty-nine','thirty',
]
/**
 * Counted by the module, said the way the rest of the page says a number.
 *
 * The list runs to thirty because the shapes are already at twenty-five and a
 * digit dropped into the middle of a sentence written in words is the tell that
 * the sentence is generated. Past thirty it falls back to the numeral, which is
 * the right answer for a count nobody reads aloud.
 */
const word = (n: number) => WORDS[n] ?? String(n)
const Word = (n: number) => (WORDS[n] ? WORDS[n][0].toUpperCase() + WORDS[n].slice(1) : String(n))

const shapes = FORMATIONS.filter((f) => !f.blank).length
const boards = PITCH_VIEW_LIST.length
const gear = GEAR.length
const officialTemplates = TEMPLATES.filter((t) => t.official).length

/**
 * The vocabulary board: a real phase out of a real system, not a mock-up.
 *
 * Act 10 of Sacchi's 25 Metres, which carries the whole drawing layer at once —
 * six cues, four dimmed options, a danger zone and a plate of text. It is drawn
 * by `Board` at build time, the same component the studio and the MP4 use, so
 * it is a picture of the product in the only sense that cannot rot.
 *
 * `credit` is dropped: the document is posed as somebody else's team and a
 * borrowed name at the foot of our own landing page is a claim, not a demo.
 */
const marksDoc: System = {
  ...(sacchi as unknown as System),
  credit: undefined,
  camera: undefined,
  push: undefined,
}
const marksAct = resolveAct({ ...marksDoc.acts[9], push: undefined }, marksDoc)
const marksView = viewFor(marksDoc)

/** Newest first already; `unseenNews` depends on that order. See the data file. */
const shipped = WHATS_NEW.slice(0, 6)
const since = WHATS_NEW[WHATS_NEW.length - 1]
const MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December']
const sinceDay = (() => {
  const [y, m, d] = since.date.split('-').map(Number)
  return `${d} ${MONTHS[m - 1]} ${y}`
})()
const NEWS_CHIP: Record<string, string> = {
  new: 'bg-gold/18 text-ink',
  better: 'bg-green/18 text-ink',
  fixed: 'bg-ink-hair text-ink-soft',
}

/**
 * The objections, answered before the sign-in wall rather than after it.
 *
 * Every question in this group was previously answerable only by opening the
 * Studio and finding out: whether it costs anything, whether it needs an
 * account, whether it works on the phone the coach is holding, where the work
 * is saved. Somebody who cannot settle those does not click "Open the Studio",
 * they close the tab.
 */
const studioFaqs = faqGroup('studio')

/**
 * The three things a coach does, in the order they do them. Numbered because
 * this genuinely is a sequence — you cannot share what you have not posed.
 */
const STEPS = [
  {
    n: '01',
    kind: 'shape' as const,
    title: 'Put your shape down',
    body: `Pick the board you want, the shape you play, and your colours. ${Word(boards)} boards, ${word(shapes)} shapes, and a blank eleven you can drag anywhere.`,
  },
  {
    n: '02',
    kind: 'phase' as const,
    title: 'Move it to the next moment',
    body: 'Add a phase and you get a copy of the board you already have. Move the players to where the ball takes them. That is the whole job: the movement between the two is worked out for you.',
  },
  {
    n: '03',
    kind: 'send' as const,
    title: 'Send it, or save the film',
    body: 'A link that plays on any phone, with no app and no account at the other end. Or an MP4, a PDF and a set of stills for the places a link will not go.',
  },
]


/**
 * What comes out, and a mark for each. Icons rather than four more paragraphs:
 * this section was the most text-heavy on the page and every item in it is a
 * concrete object a coach can picture.
 */
const ico = (d: string) =>
  `<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`

const EXPORTS = [
  {
    title: 'A link that plays',
    body: 'Seven characters. It opens on any phone with no app and no account. Change a phase and everyone who already has the link sees the new one.',
    icon: ico('<path d="M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1"/><path d="M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"/>'),
  },
  {
    title: 'An MP4',
    body: 'Landscape or vertical, 720p at 60 frames a second, encoded on your own machine. For a story, a status, a group chat.',
    icon: ico('<rect x="2" y="5" width="14" height="14" rx="2"/><path d="m16 10 6-3v10l-6-3z"/>'),
  },
  {
    title: 'Stills, one or all of them',
    body: 'PNG files, landscape, square or vertical, of one phase or every phase. Drawn through the same renderer as the film, so a picture is a frame of it.',
    icon: ico('<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.6" cy="8.6" r="1.4"/><path d="m21 15.5-5-5L5.5 21"/>'),
  },
  {
    title: 'A PDF to hand out',
    body: 'One phase a page, your notes under each board, real type that prints sharp at any size.',
    icon: ico('<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/>'),
  },
  {
    title: 'Your name on all of it',
    body: 'Your name and club at the foot of every board, ours beside them. Set it once and everything you share is signed.',
    icon: ico('<path d="M12 2 4 6v6c0 5 3.4 8.6 8 10 4.6-1.4 8-5 8-10V6z"/><path d="m9 12 2 2 4-4"/>'),
  },
  {
    title: 'Your staff, on the same board',
    body: 'Invite the coaches you work with to view or edit, either your whole collection or one system. Nobody has to screenshot anything for an assistant again.',
    icon: ico('<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>'),
  },
]

/**
 * The drawing layer, said once each. Every line here names something that is on
 * the board in the studio today; the counts come from the modules above.
 */
const MARKS = [
  {
    t: 'Arrows that hold on',
    d: 'Pass, run, carry, press and switch. Fix one to a player and it goes where he goes, phase after phase.',
  },
  {
    t: 'Blocks and zones',
    d: 'A block that closes around the men inside it, or a shaded area in nine colours, hatched or solid, box, round, triangle or diamond.',
  },
  {
    t: 'Lines that stay put',
    d: 'Hold Shift and the line comes out straight. Lock it to the pitch and it stays with the grass, not with the crop.',
  },
  {
    t: 'Words on the grass',
    d: 'Click anywhere and type: a trigger, a coaching point, a name for a space. Any size, any weight, turned to run along a touchline.',
  },
  {
    t: 'Bibs, for a session',
    d: "Split the group into teams without touching anybody's kit. A bib is a kit, so it films and prints like one.",
  },
  {
    t: 'Your squad, with faces',
    d: 'Photographs on the counters and their names above or below, so a phase is about your players rather than about letters.',
  },
]

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Total Football Studio',
    applicationCategory: 'SportsApplication',
    operatingSystem: 'Any browser',
    url: `${SITE_URL}/studio/`,
    description:
      'Build animated tactical presentations on the Total Football board. Pose the board phase by phase and the movement between the poses is worked out for you.',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  },
]
---

<BaseLayout
  title="The Studio"
  description="Build your own tactical systems on the Total Football board. Pose the board phase by phase, and the movement between the poses comes back as film, then send it as a link that plays anywhere."
  path="/studio/"
  structuredData={structuredData}
>
  {/* ── Hero ─────────────────────────────────────────────────────────── */}
  <section class="stage relative overflow-hidden border-b border-ink-hair">
    <div class="shell relative grid gap-14 py-20 md:py-28 lg:grid-cols-[1.02fr_0.98fr] lg:items-center lg:gap-12">
      <div class="max-w-[40rem]">
        <p class="micro mb-8" data-reveal="fade">The Studio · free, in your browser</p>

        <h1 class="text-display font-black" data-reveal="clip" data-reveal-delay="80">
          Your tactics,<br />
          <span class="grad-text">on our board.</span>
        </h1>

        <p
          class="mt-8 max-w-prose text-lg leading-relaxed text-ink-soft"
          data-reveal="rise"
          data-reveal-delay="160"
        >
          The same board the videos are drawn on, handed over. Pose it phase by phase (nobody
          keyframes anything) and the movement between the phases comes back as film. A match, a
          corner or a Tuesday session: same gesture, same board.
        </p>

        <div class="mt-10 flex flex-wrap items-center gap-3" data-reveal="rise" data-reveal-delay="240">
          <a href="/studio/portal/" class="btn btn-primary" data-track="studio:cta-hero">
            Open the Studio
          </a>
          <a href="/library/" class="btn btn-ghost" data-track="studio:see-one">
            See one first
          </a>
        </div>

        <p class="mt-5 text-[13px] text-ink-faint" data-reveal="fade" data-reveal-delay="300">
          Free. Nothing to install. Sign in with Google and you are on the board.
        </p>
      </div>

      {/* The product, being used. Not MiniBoard: that is the homepage's hero
          and it teaches football, not the tool. See StudioDeck.astro. */}
      <div class="relative" data-reveal="fade" data-reveal-delay="200">
        <div
          class="pointer-events-none absolute -inset-8 -z-10 rounded-full bg-tf-gradient-soft blur-3xl"
          aria-hidden="true"
        >
        </div>
        <StudioDeck
          class="drop-shadow-[0_24px_50px_rgba(22,22,24,0.10)]"
          title="The Studio: a coach drags a player to where the ball takes them, the movement is drawn behind, and a link to send appears"
        />
        <p class="mt-4 text-center text-[13px] text-ink-soft">
          Move a player. The path between where they were and where they are now is the phase.
        </p>
      </div>
    </div>
  </section>

  {/* ── The one idea ─────────────────────────────────────────────────── */}
  <section class="border-b border-ink-hair bg-paper-deep/40">
    <div class="shell py-24 md:py-32">
      <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end">
        <div>
          <p class="micro mb-6" data-reveal="fade">The one idea</p>
          <h2 class="max-w-[18ch] text-title font-black" data-reveal="clip">
            A phase is a moment, not a keyframe.
          </h2>
          <p class="mt-6 max-w-prose text-lg leading-relaxed text-ink-soft" data-reveal="rise">
            Every other tool asks you to think in timelines. This one asks you to think the way you
            already do on a whiteboard.
          </p>
        </div>

        {/* The thing you never have to do, said once and got out of the way. A
            struck-out timeline is quicker to understand than the sentence
            explaining that there isn't one. */}
        <div class="shrink-0 lg:pb-2" data-reveal="fade" data-reveal-delay="160">
          {/* inline-block, or on a phone the box stretches to the full column
              and the strike turns into a long diagonal across empty space. */}
          <div class="inline-block rounded-xl border border-ink-hair bg-paper/60 px-5 py-4">
            <p class="micro mb-3">What you never touch</p>
            <div class="relative flex items-center gap-2.5" aria-hidden="true">
              {
                [0, 1, 2, 3, 4].map((i) => (
                  <span
                    class:list={[
                      'block h-3 w-3 rotate-45 border border-ink-faint',
                      i === 2 && 'bg-ink/20',
                    ]}
                  />
                ))
              }
              <span class="ml-0.5 text-[13px] font-semibold text-ink-faint">a timeline</span>
              <span
                class="pointer-events-none absolute -inset-x-1 top-1/2 h-[1.5px] -rotate-[7deg] bg-ink/45"
              ></span>
            </div>
          </div>
        </div>
      </div>

      <div
        class="mt-14 rounded-3xl border border-ink-hair bg-surface/55 p-6 shadow-paper sm:p-10"
        data-reveal="fade"
        data-reveal-delay="120"
      >
        <PoseToFilm title="The same players posed twice, and the movement between the poses playing back" />
      </div>
    </div>
  </section>

  {/* ── How ──────────────────────────────────────────────────────────── */}
  <section class="shell py-24 md:py-32">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <h2 class="max-w-[20ch] text-title font-black" data-reveal="clip">
        Three moves, start to finish.
      </h2>
      <p class="micro" data-reveal="fade">About ten minutes</p>
    </div>

    {/*
      Each step gets the smallest true picture of itself (StepGlyph). Three
      paragraphs under three numbers described a sequence of physical actions in
      prose, which is the one thing prose is worst at. The rail behind the
      numbers is what makes it read as one run rather than three cards.
    */}
    <ol class="mt-14 grid list-none gap-12 p-0 md:grid-cols-3 md:gap-8">
      {
        STEPS.map((step, i) => (
          <li class="relative" data-reveal="rise" data-reveal-delay={i * 90}>
            <div class="mb-6 flex items-center gap-3">
              <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-ink text-[12px] font-black tabular-nums text-paper">
                {step.n}
              </span>
              {/* The rail. Stops at the last step, because the sequence does. */}
              <span
                class:list={[
                  'h-px flex-1',
                  i === STEPS.length - 1 ? 'bg-ink-hair' : 'bg-tf-gradient opacity-40',
                ]}
                aria-hidden="true"
              />
            </div>

            <StepGlyph kind={step.kind} delay={i * 700} class="mb-6" />

            <h3 class="text-xl font-black tracking-display text-ink">{step.title}</h3>
            <p class="mt-3 leading-relaxed text-ink-soft">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  {/* ── The film ─────────────────────────────────────────────────────────
      Placed here and nowhere else: the reader has just finished 01, 02, 03 in
      prose, and this is the same three moves happening. Above the steps it
      would be a trailer for something not yet explained.

      IT DOES NOT GO IN THE HERO. StudioDeck is the hero, deliberately — pure
      SVG and CSS, no JS, no layout cost, and the page's own header explains why
      showing the gesture beats any headline about it. A 4.5MB autoplaying video
      up there would undo that and fight the no-JS rule the README opens with.

      `preload="none"` so it costs a visitor nothing until they ask for it, and
      width/height so the poster reserves its box and the page does not jump —
      the same reason the phase diagrams carry explicit dimensions.

      4:5 because that is the master the film is cut in: the tallest an IG or FB
      feed will show, and a portrait card sits in this column far better than a
      16:9 letterbox would. The 9:16 derive is for TikTok and Reels and has no
      business on a web page. */}
  <section class="border-t border-ink-hair bg-paper-deep/40">
    <div class="shell py-24 md:py-32">
      <div class="grid gap-12 lg:grid-cols-[0.92fr_1.08fr] lg:items-center lg:gap-16">
        <div>
          <p class="micro mb-6" data-reveal="fade">The film · 37 seconds</p>
          <h2 class="max-w-[16ch] text-title font-black" data-reveal="clip">
            The three moves, happening.
          </h2>
          <p
            class="mt-6 max-w-prose text-lg leading-relaxed text-ink-soft"
            data-reveal="rise"
          >
            A shape goes down, a player moves, and the phase between the two plays
            itself back. Then the link, and the file.
          </p>
          <p
            class="mt-5 max-w-prose leading-relaxed text-ink-soft"
            data-reveal="rise"
            data-reveal-delay="80"
          >
            Everything on screen is the studio itself: filmed, not drawn. Nothing
            in it is an illustration of a feature that does not exist yet.
          </p>
        </div>

        <div data-reveal="fade" data-reveal-delay="160">
          <video
            class="mx-auto w-full max-w-[26rem] rounded-2xl border border-ink-hair shadow-paper"
            src="/studio/promo/studio-4x5.mp4"
            poster="/studio/promo/studio-4x5.webp"
            width="1080"
            height="1350"
            controls
            preload="none"
            playsinline
            data-track="studio:promo-play"
          ></video>
        </div>
      </div>
    </div>
  </section>

  {/* ── The boards ──────────────────────────────────────────────────────
      AFTER the film and before the exports, because this is the first
      section that widens the product past "a pitch with a shape on it", and
      that claim is only credible once the reader has seen the thing work.

      Every board here is `Board` run at build time, the same component the
      editor draws with. Not a screenshot: see BoardWall.astro's header for
      why a picture of a product is a second copy of it that nobody updates.
  */}
  <section class="border-t border-ink-hair">
    <div class="shell py-24 md:py-32">
      <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end">
        <div>
          <p class="micro mb-6" data-reveal="fade">The boards</p>
          <h2 class="max-w-[17ch] text-title font-black" data-reveal="clip">
            {Word(boards)} boards, and not one of them a screenshot.
          </h2>
          <p class="mt-6 max-w-prose text-lg leading-relaxed text-ink-soft" data-reveal="rise">
            Six crops of a full pitch for the match, two goalmouths for corners and free kicks, and
            a coned grid for the session. Every board below is being drawn on this page, right now,
            by the studio itself.
          </p>
        </div>
      </div>

      <BoardWall class="mt-14" />
    </div>
  </section>

  {/* ── What goes on it ─────────────────────────────────────────────────
      The drawing layer, which is most of what shipped since this page was
      last written and none of which it mentioned. One real phase carries the
      argument: six cues, four shut passes, a shaded trap and a plate of text
      on one board says more than six bullet points about annotation.
  */}
  <section class="border-t border-ink-hair bg-paper-deep/40">
    <div class="shell py-24 md:py-32">
      {/* The board goes FULL WIDTH and the list goes under it.

          It was a column beside the list, which made the one honest picture of
          the drawing layer the smallest thing in the section, and left a hand's
          depth of empty paper under it wherever the list ran longer. A phase
          with twenty-two men on it needs the width to be read at all. */}
      <div class="max-w-[46rem]">
        <p class="micro mb-6" data-reveal="fade">On the board</p>
        <h2 class="max-w-[15ch] text-title font-black" data-reveal="clip">
          Then you mark it up.
        </h2>
        <p class="mt-6 max-w-prose text-lg leading-relaxed text-ink-soft" data-reveal="rise">
          Eleven counters on grass is a team sheet. What makes it a session is everything drawn
          over the top, and all of it carries into the next phase with the players.
        </p>
      </div>

      <figure
        class="mt-14 rounded-3xl border border-ink-hair bg-surface/55 p-3 shadow-paper sm:p-5"
        data-reveal="fade"
        data-reveal-delay="120"
      >
        <div style={`aspect-ratio:${aspect(marksView)};width:100%`}>
          <Board system={marksDoc} act={marksAct} idp="marks" texture />
        </div>
        <figcaption class="mt-5 max-w-prose text-[13px] leading-relaxed text-ink-soft sm:px-2">
          One phase of Sacchi's 25 Metres, a system built on this board and published as a film.
          Four ways out of the press and all four shut: six men carrying a cue, the passes that are
          no longer on drawn faintly, the trap shaded behind them, and the point of it written on
          the grass. Posed on the night pitch, which is one of four the board can wear.
        </figcaption>
      </figure>

      <ul class="mt-16 grid list-none gap-x-10 gap-y-8 p-0 sm:grid-cols-2 lg:grid-cols-3">
        {
          MARKS.map((m, i) => (
            <li data-reveal="rise" data-reveal-delay={i * 60}>
              <div class="flex items-center gap-2.5">
                <span class="h-1.5 w-1.5 rounded-full bg-tf-gradient" aria-hidden="true" />
                <h3 class="text-[15px] font-black text-ink">{m.t}</h3>
              </div>
              <p class="mt-2 text-[15px] leading-relaxed text-ink-soft">{m.d}</p>
            </li>
          ))
        }
      </ul>

      {/* The kit bag. Real thumbnails off the gear catalogue, so a piece added
          to the studio turns up here without anybody editing this page. */}
      <div
        class="mt-16 rounded-2xl border border-ink-hair bg-paper p-6 sm:p-8"
        data-reveal="fade"
      >
        <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-3">
          <div>
            <p class="micro">The kit bag</p>
            <h3 class="mt-3 text-xl font-black tracking-display text-ink">
              {Word(gear)} pieces, drawn to size.
            </h3>
          </div>
          <p class="max-w-[46ch] text-[15px] leading-relaxed text-ink-soft">
            Cones, poles, hurdles, ladders, mannequins, goals and the strength kit. Every one is
            sized in metres against the grid, so a ladder is a ladder rather than a decision about
            pixels.
          </p>
        </div>

        <ul class="mt-8 flex list-none flex-wrap items-end gap-x-6 gap-y-5 p-0">
          {
            GEAR.map((g) => (
              <li class="flex w-16 flex-col items-center gap-2">
                {/* A fixed box, not a fixed image: a ladder is four times as
                    wide as a cone and a mannequin four times as tall, so only
                    the BOX can be the thing that lines up. */}
                <span class="flex h-12 w-16 items-end justify-center">
                  <img
                    src={g.thumb}
                    alt={g.name}
                    width="64"
                    height="64"
                    loading="lazy"
                    decoding="async"
                    class="max-h-12 w-auto max-w-full object-contain"
                  />
                </span>
                <span class="text-center text-[11px] leading-tight text-ink-faint">{g.name}</span>
              </li>
            ))
          }
        </ul>
      </div>

      {/* Three things that are not marks and do not deserve a section each. */}
      <ul class="mt-6 grid list-none gap-px overflow-hidden rounded-2xl border border-ink-hair bg-ink-hair p-0 sm:grid-cols-3">
        {
          [
            {
              t: 'Sequences you keep',
              d: 'Capture a movement once, save it to your own library, and drop it into any other system, on either flank.',
            },
            {
              t: 'A camera with a hand on it',
              d: 'Let it follow the ball, pick which ball it follows, or frame every phase yourself and set how far it pushes in.',
            },
            {
              t: 'Nothing typed twice',
              d: 'Move a cone, a zone or a line and the change runs forward through the rest of the phases on its own.',
            },
          ].map((x, i) => (
            <li class="bg-paper p-6" data-reveal="fade" data-reveal-delay={i * 60}>
              <h3 class="text-[15px] font-black text-ink">{x.t}</h3>
              <p class="mt-2 text-[15px] leading-relaxed text-ink-soft">{x.d}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ── What you get out ─────────────────────────────────────────────── */}
  <section class="border-y border-ink-hair bg-paper-deep/30">
    <div class="shell py-24 md:py-32">
      <div class="grid gap-12 lg:grid-cols-[0.95fr_1.05fr] lg:items-start lg:gap-16">
        <div>
          <h2 class="max-w-[16ch] text-title font-black" data-reveal="clip">
            Then it has to leave the laptop.
          </h2>
          <p class="mt-6 max-w-prose text-lg leading-relaxed text-ink-soft" data-reveal="rise">
            A presentation nobody sees is a presentation you did not need to make. So the export is
            not a file format, it is the {word(EXPORTS.length)} ways a coach actually shows people
            things.
          </p>
        </div>

        <ul class="grid list-none gap-px overflow-hidden rounded-xl border border-ink-hair bg-ink-hair p-0 sm:grid-cols-2">
          {
            EXPORTS.map((item, i) => (
              <li class="bg-paper p-6" data-reveal="fade" data-reveal-delay={i * 60}>
                <span class="mb-4 flex h-9 w-9 items-center justify-center rounded-lg bg-tf-gradient-soft text-ink">
                  <Fragment set:html={item.icon} />
                </span>
                <h3 class="text-[15px] font-black text-ink">{item.title}</h3>
                <p class="mt-2 text-[15px] leading-relaxed text-ink-soft">{item.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  {/* ── Start from ours ──────────────────────────────────────────────────
      This used to point only at /library/, which is the write-ups. The
      documents themselves are openable now: {TEMPLATES.length} of them sit in
      the studio's own shelf, and {officialTemplates} are the exact files the
      published films were rendered from, not a copy made for a demo. Sending a
      coach to an article when the board is one click away was the stalest
      thing on this page. */}
  <section class="shell py-24 md:py-32">
    <h2 class="max-w-[22ch] text-title font-black" data-reveal="clip">
      Or start from one of ours.
    </h2>
    <p class="mt-6 max-w-prose text-lg leading-relaxed text-ink-soft" data-reveal="rise">
      {Word(TEMPLATES.length)} systems built on this board are waiting on the shelf, and {word(officialTemplates)}
      of them are the documents the published films were rendered from, not a copy made for a demo.
      Open one and it is yours: move the players, rewrite the words, keep what is useful.
    </p>

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {featured.map((system) => <SystemCard system={system} />)}
    </div>

    <div class="mt-12" data-reveal="fade">
      <a href="/studio/templates/" class="btn btn-ghost" data-track="studio:templates">
        Open the shelf →
      </a>
    </div>
  </section>

  {/* ── Shipped ──────────────────────────────────────────────────────────
      The changelog the studio already keeps, read from the same file the bell
      in the toolbar reads. Six entries and a count, both derived: a landing
      page that has to be hand-edited to stay current is a landing page that
      goes stale, which is exactly how this one came to be advertising
      twenty-four formations. */}
  <section class="border-t border-ink-hair bg-paper-deep/40">
    <div class="shell py-20 md:py-24">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="micro mb-6" data-reveal="fade">Shipped</p>
          <h2 class="max-w-[20ch] text-title font-black" data-reveal="clip">
            It gets better most weeks.
          </h2>
        </div>
        <p class="max-w-[42ch] leading-relaxed text-ink-soft" data-reveal="rise">
          {WHATS_NEW.length} changes since {sinceDay}, each one written from the coach's side and
          listed in the studio itself, behind the bell.
        </p>
      </div>

      <ul class="mt-12 grid list-none gap-x-12 gap-y-6 p-0 md:grid-cols-2">
        {
          shipped.map((entry, i) => (
            <li
              class="flex items-baseline gap-4 border-b border-ink-hair pb-5"
              data-reveal="rise"
              data-reveal-delay={i * 50}
            >
              <span
                class:list={[
                  'shrink-0 rounded-full px-2 py-0.5 text-[11px] font-black uppercase tracking-wide',
                  NEWS_CHIP[entry.kind],
                ]}
              >
                {entry.kind}
              </span>
              <span class="flex-1 text-[15px] font-semibold leading-snug text-ink">
                {entry.title}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ── Questions ────────────────────────────────────────────────────────
      Immediately before the last CTA, which is the point at which a coach is
      deciding. Answering "does it work on my phone" three screens earlier, in
      the middle of the feature tour, would be answering it before it is
      being asked. */}
  <section class="border-y border-ink-hair bg-paper-deep/30">
    <div class="shell py-24 md:py-32">
      <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
        {/* Sticky: eleven questions is a tall column, and the CTA out of the
            section should not scroll away above the reader. */}
        <div class="lg:sticky lg:top-24 lg:self-start">
          <p class="micro mb-6" data-reveal="fade">Before you open it</p>
          <h2 class="max-w-[14ch] text-title font-black" data-reveal="clip">
            Fair questions.
          </h2>
          <p class="mt-6 max-w-prose leading-relaxed text-ink-soft" data-reveal="rise">
            What it costs, what it needs, and what happens to the boards you build.
          </p>
          <a href="/faq/" class="btn btn-ghost mt-9" data-track="studio:faq" data-reveal="fade" data-reveal-delay="160">
            All questions →
          </a>
        </div>

        <div data-reveal="fade" data-reveal-delay="120">
          <Faq items={studioFaqs.items} level={3} openFirst track="studio" />
        </div>
      </div>
    </div>
  </section>

  {/* ── Close ────────────────────────────────────────────────────────── */}
  <section class="bg-paper-deep/40">
    <div class="shell py-24 text-center md:py-32">
      <h2 class="mx-auto max-w-[18ch] text-title font-black" data-reveal="clip">
        Build the first one tonight.
      </h2>
      <p class="mx-auto mt-6 max-w-prose text-lg leading-relaxed text-ink-soft" data-reveal="rise">
        It is free, it runs in the browser you already have open, and the first board takes about ten
        minutes.
      </p>
      <div class="mt-10 flex justify-center" data-reveal="rise" data-reveal-delay="120">
        <a href="/studio/portal/" class="btn btn-primary" data-track="studio:cta-foot">
          Open the Studio
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
