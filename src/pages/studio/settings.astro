---
/**
 * Settings. Signed-in only, so nothing here can be rendered at build time.
 */
import BaseLayout from '../../layouts/BaseLayout.astro'
import Settings from '../../studio/account/Settings'
---

<BaseLayout
  title="Settings"
  description="How your work is signed: your name, your club and your colour."
  path="/studio/settings/"
  noindex
>
  <main class="min-h-[70vh] bg-paper-deep">
    <Settings client:only="react" />
  </main>
</BaseLayout>
