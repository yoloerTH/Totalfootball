---
/**
 * Personal settings. Signed-in only, so nothing here can be rendered at build
 * time.
 */
import BaseLayout from '../../layouts/BaseLayout.astro'
import Settings from '../../studio/account/Settings'
---

<BaseLayout
  title="Personal settings"
  description="Who you are, how your work is signed, and the kit your boards are drawn in."
  path="/studio/settings/"
  noindex
>
  <main class="min-h-[70vh] bg-paper-deep">
    <Settings client:only="react" />
  </main>
</BaseLayout>
