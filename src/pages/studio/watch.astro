---
/**
 * The shared system, as anyone who receives the link sees it.
 *
 * The document travels in the URL FRAGMENT (see src/studio/share.ts), which is
 * never sent to the server — so this page is static, cacheable, identical for
 * everybody, and knows nothing about what it is about to show. That is also why
 * it is `noindex`: there is no page here to index, only a viewer, and every
 * shared link would otherwise look like a duplicate of every other one.
 *
 * `bare`, because a coach presenting off this in front of a room does not want
 * the site's nav across the top of it.
 *
 * ── THE PRINT STYLESHEET IS THE PDF EXPORT ───────────────────────────────────
 *
 * There is no jsPDF here and no canvas. The viewer holds every phase as live
 * SVG in the document (`.tf-print`, hidden on screen); printing hands that to
 * the browser, which writes a PDF with the boards as VECTOR and the type as
 * really-Inter.
 *
 * Both halves of it used to live on this page. Neither does now: the sheet is
 * src/studio/viewer/PrintSheet.tsx and the stylesheet is in
 * src/styles/global.css, so the STUDIO can print a coach's own system without
 * publishing it first. The reasoning for both is in those two files.
 */
import BaseLayout from '../../layouts/BaseLayout.astro'
import Viewer from '../../studio/viewer/Viewer'
---

<BaseLayout
  title="A shared system"
  description="A tactical system built in the Total Football studio."
  path="/studio/watch/"
  noindex
  bare
>
  <Viewer client:only="react" />
</BaseLayout>

<!--
  The print stylesheet used to live here. It is in src/styles/global.css now, so
  the studio can print a coach's own system without publishing it first — see
  the header comment there, and src/studio/viewer/PrintSheet.tsx for the sheet
  it styles. Nothing about the rules changed in the move.
-->
