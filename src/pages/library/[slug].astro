---
/**
 * A single system. This template is the whole SEO strategy, and it gets built once
 * and repeated ~90 times, so the structure matters more than any other file.
 *
 * Page order is deliberate: question → direct answer → phases → principles →
 * related. The answer paragraph sits above everything so it is the first prose
 * in the DOM.
 */
import BaseLayout from '../../layouts/BaseLayout.astro'
import SlideViewer from '../../components/library/SlideViewer.astro'
import NewsletterForm from '../../components/NewsletterForm.astro'
import { SYSTEMS, THEMES, relatedSystems, type System } from '../../data/systems'
import { abs, SITE, SITE_URL } from '../../lib/site'

export function getStaticPaths() {
  return SYSTEMS.map((system) => ({ params: { slug: system.slug }, props: { system } }))
}

interface Props {
  system: System
}

const { system } = Astro.props
const theme = THEMES.find((t) => t.slug === system.theme)!
const related = relatedSystems(system)
const path = `/library/${system.slug}/`
const heroImage = `/library/${system.slug}/phase-01.png`

const fmt = new Intl.NumberFormat('en-GB')

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Library', item: abs('/library/') },
    { '@type': 'ListItem', position: 2, name: theme.title, item: abs(`/library/theme/${theme.slug}/`) },
    { '@type': 'ListItem', position: 3, name: system.title, item: abs(path) },
  ],
}

/**
 * Article + ImageObject only.
 *
 * Deliberately NOT HowTo (Google removed the rich result outright) and NOT
 * FAQPage (restricted to authoritative government and health sites since
 * August 2023). Marking up for rich results that no longer exist is wasted
 * bytes and a maintenance trap. See docs/SPEC.md §7.
 */
const article = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: system.title,
  description: system.description,
  datePublished: system.published,
  dateModified: system.updated,
  mainEntityOfPage: { '@type': 'WebPage', '@id': abs(path) },
  author: { '@type': 'Organization', name: SITE.name, url: SITE_URL },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    logo: { '@type': 'ImageObject', url: `${SITE_URL}/logo.png` },
  },
  image: system.phases.map((p) => ({
    '@type': 'ImageObject',
    url: `${SITE_URL}/library/${system.slug}/phase-${String(p.n).padStart(2, '0')}.png`,
    caption: p.alt,
    width: 720,
    height: 1104,
  })),
  articleSection: theme.title,
  about: { '@type': 'Thing', name: system.title },
}
---

<BaseLayout
  title={system.title}
  description={system.description}
  path={path}
  image={heroImage}
  imageAlt={system.phases[0]?.alt}
  type="article"
  publishedTime={system.published}
  modifiedTime={system.updated}
  structuredData={[breadcrumb, article]}
>
  <article>
    {/* ── Head ─────────────────────────────────────────────────────── */}
    <header class="stage border-b border-ink-hair">
      <div class="shell py-14 md:py-20">
        <nav aria-label="Breadcrumb" class="mb-8">
          <ol class="flex flex-wrap items-center gap-2 text-xs text-ink-faint">
            <li><a href="/library/" class="transition-colors hover:text-ink">Library</a></li>
            <li aria-hidden="true">/</li>
            <li>
              <a href={`/library/theme/${theme.slug}/`} class="transition-colors hover:text-ink"
                >{theme.title}</a
              >
            </li>
            <li aria-hidden="true">/</li>
            <li class="text-ink-soft" aria-current="page">{system.title}</li>
          </ol>
        </nav>

        <div class="max-w-[52rem]">
          <p class="micro mb-5">{theme.title} · {system.phases.length} phases</p>
          <h1 class="text-display font-black">{system.title}</h1>

          {/* The answer paragraph. This is what ranks: first prose in the DOM,
              a direct reply to the query, no preamble. */}
          <p class="mt-8 text-xl leading-[1.6] text-ink/90 md:text-[1.4rem] md:leading-[1.55]">
            {system.answer}
          </p>
        </div>

        <dl class="mt-12 flex flex-wrap gap-x-12 gap-y-6 border-t border-ink-hair pt-8">
          <div>
            <dt class="micro mb-2">Phases</dt>
            <dd class="text-lg font-bold tabular-nums">{system.phases.length}</dd>
          </div>
          <div>
            <dt class="micro mb-2">Original</dt>
            <dd class="text-lg font-bold tabular-nums">{system.runtimeSeconds}s</dd>
          </div>
          {
            system.plays && (
              <div>
                <dt class="micro mb-2">Plays</dt>
                <dd class="text-lg font-bold tabular-nums">{fmt.format(system.plays)}</dd>
              </div>
            )
          }
          <div>
            <dt class="micro mb-2">Updated</dt>
            <dd class="text-lg font-bold tabular-nums">
              {
                new Date(system.updated).toLocaleDateString('en-GB', {
                  month: 'short',
                  year: 'numeric',
                })
              }
            </dd>
          </div>
        </dl>
      </div>
    </header>

    {/* ── The phases ───────────────────────────────────────────────── */}
    <div class="shell py-16 md:py-24">
      <SlideViewer slug={system.slug} phases={system.phases} />
    </div>

    {/* ── Principles ───────────────────────────────────────────────── */}
    <section class="border-y border-ink-hair bg-paper-deep/40">
      <div class="shell py-16 md:py-20">
        <p class="micro mb-8">The principles</p>
        <ol class="grid gap-8 md:grid-cols-3">
          {
            system.principles.map((p, i) => (
              <li data-reveal data-reveal-delay={i * 90}>
                <span class="mb-4 block bg-tf-gradient bg-clip-text text-4xl font-black tabular-nums text-transparent">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <p class="text-[17px] leading-relaxed text-ink/85">{p}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    {/* ── Related ──────────────────────────────────────────────────── */}
    {
      related.length > 0 && (
        <section class="shell py-16 md:py-24">
          <p class="micro mb-8">Next</p>
          <ul class="grid gap-px overflow-hidden rounded-2xl bg-ink-hair sm:grid-cols-3">
            {related.map((r) => (
              <li class="bg-paper">
                <a href={`/library/${r.slug}/`} class="group block h-full p-7 transition-colors hover:bg-surface/60">
                  <p class="micro mb-4">{THEMES.find((t) => t.slug === r.theme)?.title}</p>
                  <h3 class="text-xl font-black leading-tight">{r.title}</h3>
                  <p class="mt-3 text-sm leading-relaxed text-ink-soft">{r.question}</p>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {/* ── Capture ──────────────────────────────────────────────────── */}
    <section class="shell pb-8">
      <div class="rounded-3xl border border-ink-hair bg-surface/50 p-8 md:p-12">
        <div class="grid gap-8 md:grid-cols-[1.1fr_1fr] md:items-end">
          <div>
            <h2 class="text-section font-black">Get the next one.</h2>
            <p class="mt-3 max-w-prose text-[15px] leading-relaxed text-ink-soft">
              One system a week, drawn and explained the same way.
            </p>
          </div>
          <NewsletterForm source={`library:${system.slug}`} />
        </div>
      </div>
    </section>
  </article>
</BaseLayout>
