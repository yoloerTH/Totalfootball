# build
dist/
dist-preview/
.astro/
node_modules/

# env — never commit keys
.env
.env.*
!.env.example

# netlify
.netlify/

# os
.DS_Store

# raw remotion exports — regenerate with media/export.sh
media/raw/

# rendered films — regenerate with scripts/render-video.mjs
out/

# promo plates — regenerate with scripts/shoot-studio.mjs. Hundreds of MB of
# 2x PNGs, and the shoot is deterministic, so the script is the asset.
shots/

# Supabase CLI scratch (version check cache), not project state.
supabase/.temp/

# Netlify CLI output, pulled down while debugging a deploy.
netlify-logs.txt

# Rendered previews of the Supabase auth templates. The real templates beside
# them are the source; these are for looking at.
content/auth-emails/*.preview.html
