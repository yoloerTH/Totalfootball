# The canonical origin. Change this (and add a 301 map) to move off the
# subdomain — nothing in the codebase hardcodes it.
PUBLIC_SITE_URL=https://totalfootball.naurra.ai

# Server-side only, set in the Netlify UI. Never prefixed PUBLIC_, never
# committed, never referenced from a browser bundle.
#
# These are what the Netlify functions use: subscribe, track, share. Those
# tables (001-004) have RLS on and grant nothing to anon or authenticated, so
# the function is their entire surface and its key must never reach a browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
ALLOWED_ORIGIN=https://totalfootball.naurra.ai

# Reporting and admin scripts. Never prefixed PUBLIC_, never sent to a browser.
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email. EMAIL_FROM must be an address on a domain you control and have
# authenticated, never a free gmail.com/etc one, or every send is rejected.
EMAIL_FROM="Total Football <totalfootball@naurra.ai>"
EMAIL_REPLY_TO=totalfootball@naurra.ai

# Two possible transports; whichever is configured is the one used, and
# Resend wins if both are (see scripts/lib/email.mjs).
#
# ZOHO — SMTP through the mailbox the domain already sends from. naurra.ai
# publishes `v=spf1 include:zohomail.eu` and a zmail._domainkey DKIM record,
# so mail leaving this way is SPF- and DKIM-aligned and passes DMARC with no
# extra DNS at all. The password is an APP-SPECIFIC one from
# Zoho > Settings > Security > App Passwords — never the account password, and
# revocable on its own. ZOHO_SMTP_USER is the real mailbox that owns that
# password; the alias it sends as goes in EMAIL_FROM above. Ceiling is Zoho's
# own sending limit, on the order of hundreds a day.
ZOHO_SMTP_HOST=smtp.zoho.eu
ZOHO_SMTP_USER=
ZOHO_SMTP_PASS=

# RESEND — the HTTP API (resend.com). Built for bulk, reports opens and
# bounces, batches 100 recipients per call. Needs its own DKIM records on a
# sending subdomain verified at resend.com/domains before it will send.
RESEND_API_KEY=

# Overrides the origin used for links and images in EMAIL only. Set this when
# PUBLIC_SITE_URL points at localhost — otherwise mail goes out with a dead
# logo, dead article links and a dead one-click unsubscribe endpoint. Left
# empty, a localhost PUBLIC_SITE_URL is ignored for mail and the production
# origin used instead.
EMAIL_SITE_URL=

# Signs unsubscribe links (HMAC-SHA256 of the email) so /api/unsubscribe can
# verify one without a token lookup table. Generate with:
#   openssl rand -hex 32
# Same value in this file, in Netlify's UI, and nowhere else. Rotating it
# invalidates the unsubscribe link in every email already sent.
UNSUBSCRIBE_SECRET=

# Accounts. THESE ARE SUPPOSED TO BE IN THE BROWSER BUNDLE — that is what the
# PUBLIC_ prefix means and what the anon key is for.
#
# It reads as a contradiction of the comment above, so: the anon key is not a
# secret, it is a public identifier that says which project a request is for.
# What stops one coach reading another's systems is not the key being hidden,
# it is RLS on studio_profiles and studio_systems (supabase/005), which is
# enforced by Postgres against the *signed-in user* in the request's JWT. A
# function cannot do that job, because a function has no user.
#
# The same URL and anon key as above. Duplicated under a PUBLIC_ name rather
# than un-prefixing the originals, so that anything reading `SUPABASE_ANON_KEY`
# is still, by its name alone, server-side code.
#
# The SERVICE-ROLE key is the one that must never be prefixed, never committed
# and never sent to a browser. It bypasses RLS entirely.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
