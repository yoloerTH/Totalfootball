# The canonical origin. Change this (and add a 301 map) to move off the
# subdomain — nothing in the codebase hardcodes it.
PUBLIC_SITE_URL=https://totalfootball.naurra.ai

# Server-side only, set in the Netlify UI. Never prefixed PUBLIC_, never
# committed, never referenced from a browser bundle.
#
# These are what the Netlify functions use: subscribe, track, share. Those
# tables (001-004) have RLS on and grant nothing to anon or authenticated, so
# the function is their entire surface and its key must never reach a browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
ALLOWED_ORIGIN=https://totalfootball.naurra.ai

# Reporting and admin scripts. Never prefixed PUBLIC_, never sent to a browser.
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email. EMAIL_FROM must be an address on a domain you control and have
# authenticated, never a free gmail.com/etc one, or every send is rejected.
EMAIL_FROM="Total Football <totalfootball@naurra.ai>"
EMAIL_REPLY_TO=totalfootball@naurra.ai

# ── TWO PRODUCTS, TWO JOBS ───────────────────────────────────────────────────
#
#   ZeptoMail  product mail — the welcome, and anything sent to one person
#              because of something they just did. scripts/lib/email.mjs.
#   Campaigns  newsletters and announcements. scripts/lib/campaigns.mjs.
#
# Keeping them apart is ZeptoMail's terms of service, not a preference: it is
# a transactional-only relay and bulk marketing through it is grounds for the
# account being closed. It is also what stops a newsletter complaint damaging
# the reputation of the pipe that carries a password reset.
#
# Full setup, including every DNS record: docs/EMAIL.md.

# ZEPTOMAIL — the transactional HTTP API. Get the token from
# zeptomail.zoho.eu → Mail Agents → (agent) → Setup Info → Send Mail Token.
# It is a SEND TOKEN, not an API key, and it is scoped to one mail agent, so
# revoking it stops that agent only. Store the raw token; the code adds the
# `Zoho-enczapikey ` prefix the API requires.
ZEPTOMAIL_TOKEN=
# Data centre. naurra.ai is an EU Zoho account throughout (smtp.zoho.eu, SPF
# include zohomail.eu, zmverify.zoho.eu), and a token minted in the EU DC is
# rejected by the .com host with a 401 that reads like a bad token. Leave this
# as eu unless the account genuinely moves. One of: eu com in au ca jp sa
ZEPTOMAIL_REGION=eu

# ZOHO CAMPAIGNS — newsletters. A Self Client created at api-console.zoho.eu,
# with scope ZohoCampaigns.contact.ALL,ZohoCampaigns.campaign.CREATE. The
# refresh token is minted once and does not expire; access tokens are derived
# from it in memory and never stored. ZOHO_CAMPAIGNS_LISTKEY identifies the
# audience list — Campaigns → Contacts → (list) → the key in the URL.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_CAMPAIGNS_LISTKEY=
# Data centre for BOTH accounts.zoho.* and campaigns.zoho.*, same reasoning as
# ZEPTOMAIL_REGION above.
ZOHO_DC=eu

# ZOHO MAIL SMTP — the fallback, and NOT for bulk any more.
#
# This is a MAILBOX. Sending a newsletter through it means no per-campaign
# reputation, no bounce processing, no complaint feedback loop, and a ceiling
# on the order of hundreds a day. It is kept only so that an unconfigured
# laptop or a ZeptoMail outage still delivers a welcome email.
#
# The password is an APP-SPECIFIC one from Zoho > Settings > Security > App
# Passwords — never the account password, and revocable on its own.
# ZOHO_SMTP_USER is the real mailbox that owns that password; the alias it
# sends as goes in EMAIL_FROM above.
ZOHO_SMTP_HOST=smtp.zoho.eu
ZOHO_SMTP_USER=
ZOHO_SMTP_PASS=

# Overrides the origin used for links and images in EMAIL only. Set this when
# PUBLIC_SITE_URL points at localhost — otherwise mail goes out with a dead
# logo, dead article links and a dead one-click unsubscribe endpoint. Left
# empty, a localhost PUBLIC_SITE_URL is ignored for mail and the production
# origin used instead.
EMAIL_SITE_URL=

# Signs unsubscribe links (HMAC-SHA256 of the email) so /api/unsubscribe can
# verify one without a token lookup table. Generate with:
#   openssl rand -hex 32
# Same value in this file, in Netlify's UI, and nowhere else. Rotating it
# invalidates the unsubscribe link in every email already sent.
UNSUBSCRIBE_SECRET=

# Accounts. THESE ARE SUPPOSED TO BE IN THE BROWSER BUNDLE — that is what the
# PUBLIC_ prefix means and what the anon key is for.
#
# It reads as a contradiction of the comment above, so: the anon key is not a
# secret, it is a public identifier that says which project a request is for.
# What stops one coach reading another's systems is not the key being hidden,
# it is RLS on studio_profiles and studio_systems (supabase/005), which is
# enforced by Postgres against the *signed-in user* in the request's JWT. A
# function cannot do that job, because a function has no user.
#
# The same URL and anon key as above. Duplicated under a PUBLIC_ name rather
# than un-prefixing the originals, so that anything reading `SUPABASE_ANON_KEY`
# is still, by its name alone, server-side code.
#
# The SERVICE-ROLE key is the one that must never be prefixed, never committed
# and never sent to a browser. It bypasses RLS entirely.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
